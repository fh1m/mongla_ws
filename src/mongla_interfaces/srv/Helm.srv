# One request from an operator's browser to Batighor's helm
# (mongla_batighor/helm.py), the only way a browser drives the vehicle.
# foxglove_bridge relays service calls and cannot tell browsers apart, so the
# operator names themselves; the command log trusts that name.
string   who          # the name the operator typed, remembered by their browser
                      # (not `operator`: a C++ keyword, and the field must build in C++)
string   op           # heartbeat | request | give | release | command | mission | abort | tune | camera
                      # | calibrate. To a calibration node (its `op` service): skip | undo
                      # | reset | solve | apply | configure
string   cmd          # op=command: a verb from mongla_control/commands.py
                      # op=tune: '<camera>.<setting>'; op=camera: a camera name
                      # op=calibrate: the calibration op
string   fields_json  # op=command: {"field": value} for that verb's own fields only
                      # op=tune: the new value, as JSON
                      # op=calibrate: that op's settings, as a JSON object
string   mission      # op=mission: a name `ros2 run mongla_planner mission --list` prints
string[] confirms     # op=command, cmd=arm: 'propellers_clear' and 'kill_switch_manned'
---
bool     ok
string   message      # why a refusal was refused, in words an operator can act on
