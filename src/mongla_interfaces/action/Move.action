# Goal — one field per command type, unused fields are zero/empty.
# `cmd` is any verb in the COMMANDS registry (mongla_control/commands.py is
# the single source of truth; this list is illustrative, not exhaustive):
string  cmd          # arm | disarm | set_mode | head | stop | pause | surface |
                     # mission_reset | calibrate_depth | calc_distance |
                     # move_forward | move_back | move_left | move_right |
                     # yaw_left | yaw_right | turn | set_depth | style_roll |
                     # vision_align | vision_move | motor_test | fire
float32 duration     # seconds  (move_*, pause, motor_test, vision_*)
float32 gain         # 0-100 %  (move_*, motor_test; vision_*: hard max-speed cap)
float32 target       # metres   (set_depth, negative below the surface),
                     # degrees  (yaw_*, turn), or the motor index (motor_test)
# WARNING: WHICH FIELDS THE SENDER ACTUALLY SET (issue #14). A float field defaults
# to 0.0, so "0.0" could not be told from "not given": `move_forward(gain=0)`
# became 80 % thrust and `turn` with no target turned to NORTH. The client lists
# every field it was given; when this is NON-EMPTY it is authoritative -- a
# listed 0.0 is a real zero, an unlisted field is unset and takes its default.
# EMPTY = a legacy sender, and the old "0.0 means unset" rule still applies.
string[] set_fields
string  target_name  # mode string  (set_mode)
float32 timeout      # max wait (all commands)
float32 settle       # post-command neutral-hold seconds; 0 = axis-natural settle only
string  phase        # `calc_distance`: 'start' | 'stop' (downward optical-flow odometry bracket)
float32 flips        # style_roll: number of complete 360° rotations (default 1)

# ---- vision_align / vision_move fields  (ignored by non-vision cmds) ---
string  camera             # 'forward' | 'downward' | 'laptop'
string  target_class       # class from the loaded model ('' = first available)
# vision_align: which axes are active + their signed pixel offset from centre.
string  axes               # CSV subset of 'lat,yaw,depth' (depth = surge, downward camera only)
float32 offset_lat         # px offset on lateral axis (+ = keep target right of centre)
float32 offset_yaw         # px offset on yaw axis     (+ = keep target right of centre)
float32 offset_depth       # px offset on the 'depth' axis: downward camera only, image-Y -> SURGE (+ = target below centre)
# vision_move: how far to drive in.
float32 fwd_fill           # % of frame the bbox must fill to count as reached (0 = default 95)
string  mode               # fill metric: 'area' (default) | 'width' | 'height'
float32 maintain_px        # lateral px offset to hold while driving (needs maintain_on)
bool    maintain_on        # true = hold lateral offset while moving; false = pure forward
float32 hold_s             # seconds to station-keep after reaching fwd_fill (0 = exit on reach)
# per-axis speed caps -- each overrides `gain` on one axis (0 = inherit gain).
float32 gain_lat           # lateral speed cap   (vision_align lat; vision_move maintain)
float32 gain_yaw           # yaw speed cap       (vision_align yaw)
# inertial arrival brake -- bleeds translational momentum so the hull stops where
# planned (align lateral; move forward+maintain on a fill-stop). Yaw/depth never
# brake; PASS-THROUGH and abort/loss exits never brake. ON by default: brake_off
# is the inversion so the rosidl `False`==unset rule leaves braking enabled.
bool    brake_off          # true = coast (disable the arrival brake); default false = brake on
float32 brake_gain         # reverse-kick scale vs exit-velocity EMA (0 = default)
# shared.
float32 err_px             # pixel tolerance: aligned when |err| <= this (0 = default 40)
bool    hold_through_loss  # true = coast/hold on target loss until duration (no fallback)
float32 fire_channel       # BOARD channel to fire mid-hold, 1..16 (= SERVO{n}_ROLE); 0 = NOT ASSIGNED, refused
# vision_align mid-hold fire: actuate payload WHILE the hold loop still corrects, so
# the shot leaves while glued to the target (no align-then-fire drift gap).
# WARNING: "fire" HERE MEANS ACTUATE A BOARD CHANNEL -- it is NOT a torpedo verb.
# The channel number IS the board's `SERVO{n}_ROLE` (1..16, no host-side map), so
# the same field drives a dropper solenoid, a torpedo launcher, a grabber release
# or anything else wired to the PCA9685. Nothing in this action, and nothing in
# any of the verbs, is named for a competition task -- the stack is a set of
# AUV CAPABILITIES that missions compose, and `test_the_command_surface_is_task_free`
# keeps it that way.
string  fire_channels      # vision_align: CSV board channels fired once mid-hold, e.g. "9,10" ('' = none)
float32 fire_t             # seconds into the hold to fire (0 = at hold start; must be < hold_s)
# vision tuning -- NOT mission-facing; the manager fills these from vision.* ROS
# params at dispatch (rosidl-zero triggers substitution). Mission DSL leaves them 0.
float32 kp_lat             # P gain on lateral pixel error      (0 = use vision.kp_lat)
float32 kp_yaw             # P gain on yaw pixel error          (0 = use vision.kp_yaw)
float32 kp_forward         # P gain on fill error (vision_move) (0 = use vision.kp_forward)
float32 lost_grace_s       # seconds to coast on target loss before reporting LOST (0 = 1.0)
float32 align_stable_frames# distinct in-band DETECTIONS (not loop ticks) before ALIGNED -- a
                           #   frame re-read at low FPS counts once, so one lucky frame can't
                           #   declare aligned / arm the fire (0 = use vision.align_stable_frames)
# precision-alignment knobs (close-in robustness; all opt-in, 0/false = behave as before).
bool    lock_target        # vision_align: once a target is acquired, steer to the box
                           #   NEAREST the last-accepted centre (within a gate) instead of the
                           #   largest -- so a 2nd hole / spurious box can't steal the aim
float32 ctrl_conf          # vision_align: control-side min detection score to accept a box as
                           #   the target (0 = off; distinct from the detector's global conf)
float32 range_gain_floor   # vision_align/move: lat/depth kp multiplier when the bbox FILLS the
                           #   frame (close) -- softens gain to stop the close-in overshoot of the
                           #   hull (1.0 = off, ~0.3 = gentle; 0 = use vision.range_gain_floor)
float32 ki_lat             # vision_align: lateral integral gain, cancels the steady-current
                           #   offset of the open-loop lateral axis during the hold (0 = off)
float32 settle_px          # vision_align: settle gate -- only declare aligned once the hull is
                           #   in-band AND barely moving (|Δerr| px <= this), so align ends
                           #   SETTLED on target (like vision_move's held lateral) instead of
                           #   exiting mid-pass through the band. Keyed on error velocity, so a
                           #   steady current does not block it (that is ki_lat's job). 0 = off
bool    verify_off         # vision_align: skip the post-stop RE-MEASUREMENT (Block 1C). Default
                           #   false = after braking, wait for align_stable_frames NEW frames
                           #   and return DRIFTED if the target is out of band once stopped
float32 coast_s            # vision_align/move: gap-bridging coast window (s). >0 lets the loop
                           #   steer on the tracker's predicted box of the LOCKED target id for up
                           #   to coast_s after a detection drops, at decaying authority -- a brief
                           #   occlusion keeps the lock instead of stopping. A live detection always
                           #   overrides. 0 = OFF (use vision.coast_s). MUST be < lost_grace_s.
float32 lock_s             # vision_align/move: consult the LOCK LADDER (lock_node: follower +
                           #   XFeat anchor) as the LAST rung, after coast, before declaring
                           #   loss. >0 = ON. It cannot fabricate: lock_node publishes nothing
                           #   once its own authority reaches zero, so an absent message is the
                           #   loss being declared on schedule. The value is a FLAG, not a
                           #   horizon -- the horizon lives in the node (full authority 0.70 s,
                           #   zero at 2.50 s). 0 = use vision.lock_s.
bool    fire_pass_enabled  # vision_align: if true, fire the payload at command end (TIMEOUT or hold
                           #   complete) EVEN IF never fully aligned, as long as the target was seen
                           #   live+recently (within lost_grace_s) -- a guaranteed partial-points shot.
                           #   Off = fire only on a strict in-band lock (never off-target).
# ---- downward-camera frame remap (camera=downward) ----
float32 surge_sign         # vision_align downward: +1/-1 polarity of the SURGE axis (image-Y ->
                           #   fore/aft). Flips for the physical bottom-cam mount. 0 = +1 (rosidl unset).
                           #   VERIFY DISARMED (vision_thrust_check) -- a wrong sign drives AWAY from the bin.
float32 fire_max_tilt_deg  # vision_align: HOLD the payload shot unless the target's face is
                           # square to our shot axis within this many degrees. A round leaves
                           # along the hull's axis, so a centred box is not enough -- fired
                           # 30 deg off-normal it misses an opening it was perfectly centred
                           # on. Measured against the target's 6-DoF pose (lock_node's
                           # target_pose topic), allowing for the planar FLIP AMBIGUITY: the
                           # WORSE of the two pose branches must be inside tolerance.
                           # 0 (default) = no gate, byte-identical to before. NO POSE MEANS
                           # NOT SQUARE -- an absent lock_node, an uncalibrated camera or an
                           # unset target_width_m all HOLD the shot, because for a firing
                           # gate the fail-safe direction is do not fire.
string  tool               # vision_align: WHICH TOOL is being aimed, from config/tool_geometry.yaml
                           #   ('torpedo', 'dropper', 'grabber', 'camera_forward', ...).
                           #   WARNING: The align centres the target on the CAMERA axis. A tool mounted
                           #   elsewhere fires along a PARALLEL axis, so the miss EQUALS THE OFFSET
                           #   AT EVERY RANGE -- it does not shrink as you close in. A 10 cm offset
                           #   misses a 4.75 cm-radius torpedo opening from 1 m and from 3 m alike,
                           #   with a perfectly centred box and a clean fire gate.
                           #   The correction is range-dependent (du = fx*x/Z), so it needs a live
                           #   target_pose. '' = aim the camera, which is what the stack always did.
                           #   An UNMEASURED tool warns and aims the camera rather than guessing.
float32 standoff_max_tilt_deg  # vision_align: HOLD THE APPROACH while the target's face is more
                           #   than this many degrees off-normal. The standoff feature is
                           #   sqrt(area) -- Corke & Hutchinson, IEEE T-RA 17(4) 2001 -- which that
                           #   paper bounds to "within +/-35 deg of the camera's optical axis";
                           #   past it the area "will appear diminished, due to perspective, which
                           #   causes the camera to initially approach the target". Approaching is
                           #   the dangerous direction: past the standoff into whatever we were
                           #   standing off FROM. 0 (default) = no gate, byte-identical to before.
                           #   WARNING: NO POSE MEANS UNGUARDED -- the OPPOSITE of fire_max_tilt_deg, and
                           #   deliberate: a pose needs lock_node + a calibration + a committed
                           #   width, so "no pose" is the ordinary case and failing closed would
                           #   disable forward drive on every mission without one.
float32 fire_gap           # vision_align: seconds BETWEEN channels when firing a LIST (fire=[9,10]) -- the
                           #   solenoid launcher misfires if two go together. 0 = back-to-back (single-shot
                           #   unaffected). ~1.0 for the dual torpedo/dropper drop.
---
# Result — final_value is set on the axis the command moves:
#   yaw_left / yaw_right / turn :  final_value = heading after [deg, 0..360]
#   set_depth / move_* / pause  :  final_value = depth after [m, negative below surface]
#   motor_test                  :  final_value = the motor index
#   fire                        :  final_value = the FireResult code
#   head                        :  final_value = heading now [deg]
#   arm / disarm / stop  :  final_value = current depth [m]
#   vision_align         :  success     = True (the verb ran; never fails the mission)
#                           final_value = outcome code (0=ALIGNED,1=LOST,2=TIMEOUT,
#                                         3=NO_CAMERA,4=ABORTED,5=DRIFTED)
#                           error_value = worst per-axis residual px from the goal
#   vision_move          :  success     = True (the verb ran)
#                           final_value = outcome code (0=REACHED, see above;
#                                         a pass-through ends 6=ESTIMATED_CROSSING
#                                         or 7=COMMIT_UNVERIFIED, never 0)
#                           error_value = lateral residual px (maintain) at exit
# vision_align / vision_move ALSO set the rich end-state fields below so a mission
# can branch on WHERE/HOW the verb finished (hybrid vision+control recovery):
#   end_x_px / end_y_px = SIGNED px of the target from frame CENTRE at the last
#                         seen frame (+x = right, +y = below); NaN = never seen.
#   fill_frac           = bbox fill fraction at exit [0..1] (vision_move; 0 align).
#   elapsed_s           = verb duration. (Non-vision verbs leave these NaN/0.)
# HOW it ended, for a mission to branch on: a refusal by the board, a deadline
# and a cancel are different facts, and `success` alone cannot tell them apart.
# The values are mongla_control/fc/base.py's, and a test holds the two equal.
# The vision verbs report SUCCEEDED here (the verb ran) and their own outcome
# in final_value, as above.
uint8 SUCCEEDED=0   # the board, or the host, did what was asked
uint8 PREEMPTED=1   # a newer goal displaced this one before or while it ran
uint8 FAILED=2      # it could not be done (the board's FAILED, or an exception)
uint8 DENIED=3      # refused before it started: unknown verb, bad field
uint8 TIMEOUT=4     # a deadline passed with no terminal answer
uint8 ABORTED=5     # cancelled, by the operator or an abort
bool    success
uint8   code
string  message
float32 final_value
float32 error_value
float32 end_x_px
float32 end_y_px
float32 fill_frac
float32 elapsed_s
---
# Feedback — streamed at ~2.5 Hz while the goal is EXECUTING.
# current_value is depth (m); status_line is a human-readable one-liner.
# err_x_px / err_y_px stream the live SIGNED target-from-centre px during a
# vision verb (NaN otherwise) so an operator can watch convergence in real time.
string  phase        # e.g. "EXECUTING", "DONE"
float32 current_value
float32 error_value
float32 err_x_px
float32 err_y_px
string  status_line  # human-readable one-liner
