{
  "configById": {
    "Image!floorcam": {
      "imageMode": {
        "imageTopic": "/mongla/vision/downward/stream/compressed",
        "annotations": {
          "/mongla/vision/downward/flow_annotations": {
            "visible": true
          },
          "/mongla/vision/downward/floor_annotations": {
            "visible": true
          }
        }
      },
      "lichtblickPanelTitle": "downward camera, the floor read"
    },
    "Plot!distance": {
      "paths": [
        {
          "value": "/mongla/vision/downward/distance_traveled.data",
          "label": "distance m",
          "enabled": true,
          "timestampMethod": "receiveTime"
        }
      ],
      "showLegend": true,
      "legendDisplay": "left",
      "sidebarDimension": 163,
      "followingViewWidth": 60,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "lichtblickPanelTitle": "distance"
    },
    "Plot!tracks": {
      "paths": [
        {
          "value": "/mongla/vision/downward/distance_debug.data[2]",
          "label": "tracks",
          "enabled": true,
          "timestampMethod": "receiveTime"
        }
      ],
      "showLegend": true,
      "legendDisplay": "left",
      "sidebarDimension": 117,
      "followingViewWidth": 60,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "lichtblickPanelTitle": "tracks"
    },
    "Plot!velocity": {
      "paths": [
        {
          "value": "/mongla/vision/downward/velocity.twist.twist.linear.x",
          "label": "flow vx m/s",
          "enabled": true,
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/mongla/vision/downward/velocity.twist.twist.linear.y",
          "label": "flow vy m/s",
          "enabled": true,
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/mongla/odom.twist.twist.linear.x",
          "label": "filter vx m/s",
          "enabled": true
        },
        {
          "value": "/mongla/odom.twist.twist.linear.y",
          "label": "filter vy m/s",
          "enabled": true
        }
      ],
      "showLegend": true,
      "legendDisplay": "left",
      "sidebarDimension": 190,
      "followingViewWidth": 60,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "lichtblickPanelTitle": "velocity"
    },
    "StateTransitions!calibration": {
      "paths": [
        {
          "value": "/mongla/vision/downward/flow_calibration.data",
          "label": "scale from",
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/mongla/flow/height_source.data",
          "label": "height from",
          "timestampMethod": "receiveTime"
        }
      ],
      "isSynced": false,
      "xAxisRange": 60,
      "lichtblickPanelTitle": "velocity scale"
    },
    "Plot!quality": {
      "paths": [
        {
          "value": "/mongla/vision/downward/flow_quality.data",
          "label": "quality",
          "enabled": true,
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/mongla/vision/downward/distance_debug.data[1]",
          "label": "height m",
          "enabled": true,
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/mongla/vision/downward/floor_height.range",
          "label": "floor (tile)",
          "enabled": true
        }
      ],
      "showLegend": true,
      "legendDisplay": "left",
      "sidebarDimension": 186,
      "followingViewWidth": 60,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "lichtblickPanelTitle": "flow quality and heights"
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": {
    "speed": 1
  },
  "layout": {
    "direction": "row",
    "first": {
      "direction": "column",
      "first": "Image!floorcam",
      "second": {
        "direction": "row",
        "first": "Plot!distance",
        "second": "Plot!tracks",
        "splitPercentage": 50.0
      },
      "splitPercentage": 80.0
    },
    "second": {
      "direction": "column",
      "first": "Plot!velocity",
      "second": {
        "direction": "column",
        "first": "StateTransitions!calibration",
        "second": "Plot!quality",
        "splitPercentage": 50.0
      },
      "splitPercentage": 33.3
    },
    "splitPercentage": 62.0
  }
}
