        },
        {
          "value": "/mongla/vision/forward/seeing.data",
          "label": "forward seeing",
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/mongla/vision/downward/lock.detections[0].results[0].hypothesis.class_id",
          "label": "downward rung"
