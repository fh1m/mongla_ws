      "imageMode": {
        "imageTopic": "/mongla/vision/forward/stream/compressed",
        "annotations": {
          "/mongla/vision/forward/annotations": {
            "visible": true
          }
        }
      }
    },
    "Image!downward": {
      "imageMode": {
        "imageTopic": "/mongla/vision/downward/stream/compressed",
        "annotations": {
          "/mongla/vision/downward/annotations": {
            "visible": true
          },
          "/mongla/vision/downward/flow_annotations": {
            "visible": true
          }
        }
      }
    },
    "StateTransitions!ladder": {
      "paths": [
