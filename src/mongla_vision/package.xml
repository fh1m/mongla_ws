<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mongla_vision</name>
  <version>0.1.0</version>
  <description>
    Perception package for Mongla: a uniform Camera interface (USB webcam,
    V4L2 mailbox, video file, ROS image topic), a Hailo-8 detector (.hef) with a
    YOLO11 .pt fallback for dev boxes, and rich on-image visualizations (boxes, labels,
    crosshair, alignment markers, offset readout) so problems are visible in
    one frame. ByteTrack + Kalman filtering in v2/v3.
  </description>
  <maintainer email="fh1m.dev@gmail.com">Muhammad Fahim Faisal</maintainer>
  <license>MIT</license>

  <!-- imported by the code; test_package_xml_declares_imports.py keeps these true -->
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>


  <exec_depend>rclpy</exec_depend>
  <exec_depend>mongla_localization</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>mongla_interfaces</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>

  <test_depend>ament_pep257</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
