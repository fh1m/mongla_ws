{
  // ── Mongla / duburi_ws — tuned for VSCode Remote-SSH onto the Jetson ──
  // The single biggest source of editor lag on a colcon workspace is the
  // file watcher + search indexing the generated build/ install/ log/ trees
  // (~1k+ churning files). Excluding them makes editing missions/code snappy
  // over Remote-SSH. Edit src/ only; rebuild with ./build_duburi.sh.

  // Don't watch generated / heavy dirs (kills "files changed" CPU churn).
  "files.watcherExclude": {
    "**/build/**": true,
    "**/install/**": true,
    "**/log/**": true,
    "**/.git/**": true,
    "**/__pycache__/**": true,
    "**/*.engine": true,
    "**/*.pt": true,
    "**/*.onnx": true,
    "**/graphify-out/**": true
  },

  // Keep search fast + relevant (results from src/ + docs, not generated code).
  "search.exclude": {
    "**/build": true,
    "**/install": true,
    "**/log": true,
    "**/__pycache__": true,
    "**/*.engine": true,
    "**/*.pt": true,
    "**/graphify-out": true
  },

  // Hide the generated colcon trees from the Explorer to declutter.
  "files.exclude": {
    "**/build": true,
    "**/install": true,
    "**/log": true,
    "**/__pycache__": true,
    "**/*.pyc": true
  },

  // Python: don't let the language server crawl the generated trees either.
  "python.analysis.exclude": [
    "**/build/**",
    "**/install/**",
    "**/log/**"
  ],

  // Trim trailing churn so diffs stay clean across remote edits.
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true
}
