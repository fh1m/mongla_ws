# ─── colcon build artefacts ───────────────────────────────────────────
build/
install/
log/

# Per-package build detritus
src/*/build/
src/*/install/
src/*/log/
src/*/.eggs/
src/*/*.egg-info/

# ─── Python bytecode / packaging ───────────────────────────────────────
__pycache__/
*.py[cod]
*.so
.Python
.pytest_cache/
.coverage
.tox/
.mypy_cache/
.ruff_cache/

# ─── Virtualenvs ───────────────────────────────────────────────────────
.venv/
venv/
env/

# ─── IDE / editor ──────────────────────────────────────────────────────
.vscode/
# …but DO share the workspace perf config (watcher/search excludes for the
# generated colcon trees) — keeps editing snappy over VSCode Remote-SSH.
!.vscode/
!.vscode/settings.json
.idea/
*.swp
*~
.DS_Store

# ─── Local agent / caches (do NOT commit transient state) ──────────────
.remember/
.codegraph/
.omp/
.cursor/
.claude/plugins/
# Session handoff notes (.agent/HANDOFF.md): resume state, not project history.
.agent/
# The Hailo DFC writes its quantisation scratch into the directory it runs in.
bias_correction_cache_*/
native_cache*/
quant_cache*/

# ─── Local secrets / env ───────────────────────────────────────────────
.env
*.env.local
secrets.yaml

# ─── ROS2 conventional ignores ─────────────────────────────────────────
*.rviz.bak
*.bag
*.db3
*.mcap

# ─── MAVLink runtime artefacts (pymavlink tlogs, run scoreboards) ──────
mav.tlog
mav.tlog.raw
logs/
mission_scoreboard_*.json

# ─── ML model weights (downloaded on demand by Ultralytics) ────────────
*.pt
*.pth
*.onnx
*.engine
# Hailo-8 compiled graph -- the Pi + AI HAT+ equivalent of a .engine.
*.hef
# Except the vehicle's own models, versioned in Git LFS (.gitattributes): the
# trained weights, the export and the compiled graph, beside the <stem>.yaml
# sidecar that is mandatory on the Hailo. Anywhere else these stay ignored.
!src/mongla_vision/models/*.pt
!src/mongla_vision/models/*.onnx
!src/mongla_vision/models/*.hef
trt_export.log

# ─── Generated package files we DO check in ────────────────────────────
# (explicitly whitelisted below even though the rules above would skip them)
!src/**/package.xml
!src/**/setup.py
!src/**/setup.cfg
!src/**/pyproject.toml

# Proof of Contribution
.poc/provenance.db

# ─── Knowledge-graph / code-analysis tool artifacts (regenerable) ──────
.understand-anything/

# rendered doc previews (tools/site/preview_docs.py) - look at them, never publish them
docs/_preview_*.html

# rendered README preview (tools/readme_preview.html)
docs/_readme_preview.html
docs/__repo__

# control_bench build artefacts (the .so is rebuilt from the firmware checkout)
tools/bench/control_bench/libcontrolbench.so
tools/bench/control_bench/.firmware_rev

# ─── Session transcripts ───────────────────────────────────────────────
# reasoning: a 965 KB Claude Code transcript was committed to this public
# repo once. Transcripts carry working context that was never meant to ship.
*_chats.txt
*-transcript.txt

# Hailo DFC logs: written into the working directory by the compiler.
# tools/bench/hailo_compile.py runs it from its --out directory; never commit these.
acceleras.log
allocator.log
hailo_sdk.*.log

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Editor/LSP config generated by the local harness (points at this machine's ROS install)
pyrightconfig.json
# The local tracker export: it carries authors' emails, so it stays on this machine (bv reads it here).
.beads/issues.jsonl
