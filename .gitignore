# ─── colcon build artefacts ───────────────────────────────────────────
build/
install/
log/

# Per-package build detritus
src/*/build/
src/*/install/
src/*/log/
src/*/.eggs/
src/*/*.egg-info/

# ─── Python bytecode / packaging ───────────────────────────────────────
__pycache__/
*.py[cod]
*.so
.Python
.pytest_cache/
.coverage
.tox/
.mypy_cache/
.ruff_cache/

# ─── Virtualenvs ───────────────────────────────────────────────────────
.venv/
venv/
env/

# ─── IDE / editor ──────────────────────────────────────────────────────
.vscode/
# …but DO share the workspace perf config (watcher/search excludes for the
# generated colcon trees) — keeps editing snappy over VSCode Remote-SSH.
!.vscode/
!.vscode/settings.json
.idea/
*.swp
*~
.DS_Store

# ─── Local agent / caches (do NOT commit transient state) ──────────────
.remember/
.cursor/
.claude/plugins/

# ─── Local secrets / env ───────────────────────────────────────────────
.env
*.env.local
secrets.yaml

# ─── ROS2 conventional ignores ─────────────────────────────────────────
*.rviz.bak
*.bag
*.db3
*.mcap

# ─── ArduSub SITL / MAVLink runtime artefacts ──────────────────────────
eeprom.bin
mav.parm
mav.tlog
mav.tlog.raw
logs/
mission_scoreboard_*.json

# ─── ML model weights (downloaded on demand by Ultralytics) ────────────
*.pt
*.pth
*.onnx
*.engine
# Hailo-8 compiled graph -- the Pi + AI HAT+ equivalent of a .engine. Same
# reasoning: a device-locked binary artifact, mirrored from ~/models by
# build_mongla.sh, never committed. The <stem>.yaml sidecar beside it IS
# committed, and on this backend it is mandatory rather than advisory.
*.hef
trt_export.log

# ─── Generated package files we DO check in ────────────────────────────
# (explicitly whitelisted below even though the rules above would skip them)
!src/**/package.xml
!src/**/setup.py
!src/**/setup.cfg
!src/**/pyproject.toml

# Proof of Contribution
.poc/provenance.db

# ─── Knowledge-graph / code-analysis tool artifacts (regenerable) ──────
graphify-out/
.understand-anything/

# rendered doc previews (tools/preview_docs.py) - look at them, never publish them
docs/_preview_*.html
