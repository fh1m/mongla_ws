<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>duburi_sim_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch orchestration for the Duburi AUV simulator: Gazebo Harmonic, ArduSub
    SITL over the JSON backend, and the ROS bridge.
  </description>

  <maintainer email="fh1m@users.noreply.github.com">fh1m</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>duburi_sim_description</exec_depend>
  <exec_depend>duburi_sim_worlds</exec_depend>
  <exec_depend>duburi_sim_bridge</exec_depend>
  <exec_depend>duburi_sim_scenarios</exec_depend>
  <!-- NOT declared: duburi_sim_web. `duburi_sim lab` launches it, and its
       server.py shells back to `duburi_sim stop|sim|stack`: a real mutual
       runtime edge. exec_depend feeds colcon's topological sort, so spelling
       both out makes the workspace refuse to build ("Unable to order packages
       topologically"). The web to bringup direction is kept because it is the
       build-relevant one; this comment is the other half. -->
  <!-- Cross-workspace (duburi_ws/src). Not resolvable by rosdep; declared
       because stack.launch.py does get_package_share_directory() on the
       first two and scripts/duburi_sim shells out to the third. -->
  <exec_depend>duburi_manager</exec_depend>
  <exec_depend>duburi_vision</exec_depend>
  <exec_depend>duburi_planner</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
