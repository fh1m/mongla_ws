<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>duburi_sim_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch orchestration for the Duburi AUV simulator: Gazebo Harmonic, ArduSub
    SITL over the JSON backend, and the ROS bridge.
  </description>

  <maintainer email="fh1m@users.noreply.github.com">fh1m</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>duburi_sim_description</exec_depend>
  <exec_depend>duburi_sim_worlds</exec_depend>
  <exec_depend>duburi_sim_bridge</exec_depend>
  <exec_depend>duburi_sim_scenarios</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
