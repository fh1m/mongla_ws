<?xml version='1.0' encoding='UTF-8'?>
<root>
 <!-- Duburi sim starter layout: load ROS2 Streaming Plugin, then drag these topics.
      Topics of interest:
        /duburi/state
        /duburi/sim/ground_truth
      Install: sudo apt install ros-humble-plotjuggler-ros
      Launch:  ros2 run duburi_sim_bringup duburi_sim plotjuggler
 -->
 <tabbed_widget name="Main Window" parent="main_window">
  <Tab tab_name="state" containers="1">
   <Container>
    <DockSplitter sizes="1" orientation="-" count="1">
     <DockArea name="...">
      <plot style="Lines" flip_y="false" flip_x="false" mode="TimeSeries">
       <range top="1" left="0" bottom="-1" right="20"/>
       <limitY/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <currentTabIndex index="0"/>
 </tabbed_widget>
 <use_relative_time_offset enabled="1"/>
 <Plugins>
  <plugin ID="DataLoad ROS2"/>
  <plugin ID="ROS2 Topic Subscriber"/>
 </Plugins>
</root>
