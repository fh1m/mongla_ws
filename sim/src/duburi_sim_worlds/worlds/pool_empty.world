<?xml version="1.0"?>
<!--
  GENERATED FILE - do not edit.

  Produced by duburi_sim_worlds/scripts/gen_world.py from
  courses/pool_empty.yaml and spec/arena.yaml. Edit those and re-run:

      scripts/gen_world.py --all

  Bare pool with no props. This is the course to use for hydrodynamic tuning and step-response tests, where props would only add contacts and confuse the result. Fog is effectively disabled so the vehicle stays visible from any camera angle.
-->
<sdf version="1.9">
  <world name="pool_empty">

    <!-- ===================== SYSTEMS ===================== -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Required by the vehicle's IMU, which feeds ArduSub over the JSON link. -->
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <!-- Required by the front and bottom cameras. Without this the sensors load
         but never publish, and the failure is silent. -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Graded buoyancy: water below the surface, air above it. This is what
         lets the vehicle float at z = 0 rather than being pushed out of the pool.
         <enable> is a whitelist, so every model that needs buoyancy has to be
         named here; the pool shell is static and deliberately left out. -->
    <plugin filename="gz-sim-buoyancy-system"
            name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
      <enable>duburi</enable>
    </plugin>

    <!-- ===================== ENVIRONMENT ===================== -->
    <physics name="default" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.81</gravity>
    <magnetic_field>3.9e-05 1.1e-06 2.6e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.5 0.55 0.6 1</ambient>
      <background>0.08 0.26 0.4 1</background>
      <shadows>true</shadows>
      <!-- Linear fog stands in for water turbidity. It is the single biggest
           lever on how hard the perception task is, so it is course-tunable. -->
      <fog>
        <color>0.14 0.34 0.42 1</color>
        <type>linear</type>
        <start>5.0</start>
        <end>60.0</end>
        <density>0.005</density>
      </fog>
    </scene>

    <!-- Lights stay deliberately dim. Underwater scenes clip to white easily:
         the floor fills most of the frame and reflects most of what reaches it.
         A third soft cool fill stands in for caustic bounce without washing tiles. -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.48 0.52 0.56 1</diffuse>
      <specular>0.10 0.10 0.11 1</specular>
      <direction>-0.4 0.15 -0.9</direction>
    </light>

    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.22 0.28 0.34 1</diffuse>
      <specular>0.04 0.05 0.06 1</specular>
      <direction>0.3 -0.2 -1</direction>
    </light>

    <light type="directional" name="caustic_fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.12 0.22 0.26 1</diffuse>
      <specular>0.02 0.03 0.04 1</specular>
      <direction>0.1 0.35 -0.85</direction>
    </light>

    <!-- ===================== POOL ===================== -->
    <!-- Water surface at z = 0, floor at z = -1.6. -->
    <model name="sauvc_pool">
      <static>true</static>
      <link name="floor">
        <pose>0 0 -1.6 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1000</mass>
          <inertia>
            <ixx>1000</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1000</iyy><iyz>0</iyz>
            <izz>1000</izz>
          </inertia>
        </inertial>
        <visual name="floor_visual">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>25 16 0.01</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
            <emissive>0 0 0 1</emissive>
            <pbr>
              <metal>
                <albedo_map>model://sauvc_textures/pool_floor.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>0.85</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="floor_collision">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry><box><size>25 16 0.1</size></box></geometry>
        </collision>
      </link>
      <link name="wall_x_pos">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1000</mass>
          <inertia>
            <ixx>1000</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1000</iyy><iyz>0</iyz>
            <izz>1000</izz>
          </inertia>
        </inertial>
        <visual name="wall_x_pos_visual">
          <pose>12.5 0 -0.8 0 0 0</pose>
          <geometry><box><size>0.01 16 1.6</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
            <emissive>0 0 0 1</emissive>
            <pbr>
              <metal>
                <albedo_map>model://sauvc_textures/pool_wall_long.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>0.85</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="wall_x_pos_collision">
          <pose>12.605 0 -0.8 0 0 0</pose>
          <geometry><box><size>0.2 16.4 1.6</size></box></geometry>
        </collision>
      </link>
      <link name="wall_x_neg">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1000</mass>
          <inertia>
            <ixx>1000</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1000</iyy><iyz>0</iyz>
            <izz>1000</izz>
          </inertia>
        </inertial>
        <visual name="wall_x_neg_visual">
          <pose>-12.5 0 -0.8 0 0 0</pose>
          <geometry><box><size>0.01 16 1.6</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
            <emissive>0 0 0 1</emissive>
            <pbr>
              <metal>
                <albedo_map>model://sauvc_textures/pool_wall_long.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>0.85</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="wall_x_neg_collision">
          <pose>-12.605 0 -0.8 0 0 0</pose>
          <geometry><box><size>0.2 16.4 1.6</size></box></geometry>
        </collision>
      </link>
      <link name="wall_y_pos">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1000</mass>
          <inertia>
            <ixx>1000</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1000</iyy><iyz>0</iyz>
            <izz>1000</izz>
          </inertia>
        </inertial>
        <visual name="wall_y_pos_visual">
          <pose>0 8 -0.8 0 0 0</pose>
          <geometry><box><size>25 0.01 1.6</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
            <emissive>0 0 0 1</emissive>
            <pbr>
              <metal>
                <albedo_map>model://sauvc_textures/pool_wall_short.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>0.85</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="wall_y_pos_collision">
          <pose>0 8.105 -0.8 0 0 0</pose>
          <geometry><box><size>25 0.2 1.6</size></box></geometry>
        </collision>
      </link>
      <link name="wall_y_neg">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1000</mass>
          <inertia>
            <ixx>1000</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1000</iyy><iyz>0</iyz>
            <izz>1000</izz>
          </inertia>
        </inertial>
        <visual name="wall_y_neg_visual">
          <pose>0 -8 -0.8 0 0 0</pose>
          <geometry><box><size>25 0.01 1.6</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
            <emissive>0 0 0 1</emissive>
            <pbr>
              <metal>
                <albedo_map>model://sauvc_textures/pool_wall_short.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>0.85</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="wall_y_neg_collision">
          <pose>0 -8.105 -0.8 0 0 0</pose>
          <geometry><box><size>25 0.2 1.6</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ===================== PROPS ===================== -->


    <!-- ===================== VEHICLE ===================== -->
    <include>
      <uri>model://duburi_heavy</uri>
      <name>duburi</name>
      <pose>0 0 -0.8 0 0 0</pose>
    </include>

  </world>
</sdf>
