<?xml version="1.0"?>
<!--
  GENERATED FILE - do not edit.

  Produced by duburi_sim_worlds/scripts/gen_world.py from
  courses/task_navigation.yaml and spec/arena.yaml. Edit those and re-run:

      scripts/gen_world.py --all

  Navigation task in isolation: the gate at ~16 m from the starting zone with the orange flare as the obstacle, and nothing else in the water.
Drill the gate approach without the drums and bump flares in frame to confuse the detector. Clear-ish water so a failure here is a control or alignment failure, not a perception one -- move to sauvc26_final for the murky version.
SHORT RANGE ON PURPOSE. sauvc26_final holds the rulebook's ~16 m start-to-gate distance; this course puts the gate at 7 m so a run is a gate approach and not 90 s of open-water transit first. The two are meant to be used together: drill here, verify the real distance there.
-->
<sdf version="1.9">
  <world name="task_navigation">

    <!-- ===================== SYSTEMS ===================== -->
    <plugin filename="gz-sim-particle-emitter-system"
            name="gz::sim::systems::ParticleEmitter"/>
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Required by the vehicle's IMU, which feeds ArduSub over the JSON link. -->
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <!-- Required by the front and bottom cameras. Without this the sensors load
         but never publish, and the failure is silent. -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Required by the vehicle's DVL. Same silent-failure trap as the sensors
         system above: without this the <sensor gz:type="dvl"> loads and never
         publishes, and nothing logs a complaint. -->
    <plugin filename="gz-sim-dvl-system"
            name="gz::sim::systems::DopplerVelocityLogSystem"/>

    <!-- Graded buoyancy: water below the surface, air above it. This is what
         lets the vehicle float at z = 0 rather than being pushed out of the pool.
         <enable> is a whitelist, so every model that needs buoyancy has to be
         named here; the pool shell is static and deliberately left out. -->
    <plugin filename="gz-sim-buoyancy-system"
            name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
      <enable>duburi</enable>
    </plugin>

    <!-- ===================== ENVIRONMENT ===================== -->
    <!-- SOLVER. The three top-level numbers were the only physics settings for
         a long time; everything below them was DART's default, unstated and
         unexaminable.

         max_step_size stays at 1 ms unless something measured says otherwise.
         The reason is the added-mass ratio: heave carries 18.7 kg of added mass
         against a 13.5 kg hull, a ratio of 1.38, and the documented failure
         mode is that ratio diverging into an ODE assertion (HYDRODYNAMICS.md).
         A larger step buys speed and spends exactly the margin that keeps that
         from happening.

         The collision detector matters more than the iteration count here: this
         world is a handful of primitive boxes and cylinders, not meshes, so the
         solver is not where the time goes -- rendering is (see PHYSICS.md). -->
    <physics name="default" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <dart>
        <collision_detector>dart</collision_detector>
        <solver>
          <solver_type>dantzig</solver_type>
        </solver>
      </dart>
    </physics>

    <gravity>0 0 -9.81</gravity>
    <magnetic_field>3.9e-05 1.1e-06 2.6e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.28 0.4 0.48 1</ambient>
      <background>0.08 0.26 0.4 1</background>
      <shadows>true</shadows>
      <!-- INERT. Kept because sdformat validates it and a future gz-sim may
           honour it, but MEASURED on gz-sim 8 (Harmonic) 2026-08-28: this block
           has NO effect on camera-sensor renders. Dropping <end> from 18 m to
           3 m left the 25 m far wall pixel-for-pixel identical.

           Water turbidity is produced by `underwater_fx` instead, which
           post-processes image_raw into image_fx in ROS. The course's
           `lighting:` preset writes <course>.fx.yaml next to this world and
           bridge.launch.py loads it. Do not tune turbidity here; nothing will
           change and the next person will believe the numbers. -->
      <fog>
        <color>0.14 0.34 0.42 1</color>
        <type>linear</type>
        <start>2.0</start>
        <end>22.0</end>
        <density>0.018</density>
      </fog>
      <!-- Sky. Only ever seen through the surface looking up, and that is the
           point: without it the world above z=0 is flat background colour and
           the surface reads as a hard ceiling. With it there is a horizon, which
           is what every competition photo shows from below.

           <sky> is what gives the surface something to refract; it does not
           light the scene (the directional lights below do that), so turning it
           on does not change how props are exposed. -->
      <sky></sky>
    </scene>

    <!-- Lights stay deliberately dim. Underwater scenes clip to white easily:
         the floor fills most of the frame and reflects most of what reaches it.
         A third soft cool fill stands in for caustic bounce without washing tiles. -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.48 0.52 0.56 1</diffuse>
      <specular>0.10 0.10 0.11 1</specular>
      <direction>-0.4 0.15 -0.9</direction>
    </light>

    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.22 0.28 0.34 1</diffuse>
      <specular>0.04 0.05 0.06 1</specular>
      <direction>0.3 -0.2 -1</direction>
    </light>

    <light type="directional" name="caustic_fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.12 0.22 0.26 1</diffuse>
      <specular>0.02 0.03 0.04 1</specular>
      <direction>0.1 0.35 -0.85</direction>
    </light>

    <!-- ===================== POOL ===================== -->
    <!-- Water surface at z = 0, floor at z = -1.6. -->
    <model name="sauvc_pool">
      <static>true</static>
      <link name="floor_neg">
        <pose>-6.25 0 -1.4 0 0.0319891 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1000</mass>
          <inertia>
            <ixx>1000</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1000</iyy><iyz>0</iyz>
            <izz>1000</izz>
          </inertia>
        </inertial>
        <visual name="floor_neg_visual">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>12.5064 16 0.01</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
            <emissive>0 0 0 1</emissive>
            <pbr>
              <metal>
                <albedo_map>model://sauvc_textures/pool_floor_neg.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>0.85</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="floor_neg_collision">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry><box><size>12.5064 16 0.1</size></box></geometry>
        </collision>
      </link>
      <link name="floor_pos">
        <pose>6.25 0 -1.4 0 -0.0319891 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1000</mass>
          <inertia>
            <ixx>1000</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1000</iyy><iyz>0</iyz>
            <izz>1000</izz>
          </inertia>
        </inertial>
        <visual name="floor_pos_visual">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>12.5064 16 0.01</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
            <emissive>0 0 0 1</emissive>
            <pbr>
              <metal>
                <albedo_map>model://sauvc_textures/pool_floor_pos.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>0.85</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="floor_pos_collision">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry><box><size>12.5064 16 0.1</size></box></geometry>
        </collision>
      </link>
      <link name="wall_x_pos">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1000</mass>
          <inertia>
            <ixx>1000</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1000</iyy><iyz>0</iyz>
            <izz>1000</izz>
          </inertia>
        </inertial>
        <visual name="wall_x_pos_visual">
          <pose>12.5 0 -0.8 0 0 0</pose>
          <geometry><box><size>0.01 16 1.6</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
            <emissive>0 0 0 1</emissive>
            <pbr>
              <metal>
                <albedo_map>model://sauvc_textures/pool_wall_long.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>0.85</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="wall_x_pos_collision">
          <pose>12.605 0 -0.8 0 0 0</pose>
          <geometry><box><size>0.2 16.4 1.6</size></box></geometry>
        </collision>
      </link>
      <link name="wall_x_neg">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1000</mass>
          <inertia>
            <ixx>1000</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1000</iyy><iyz>0</iyz>
            <izz>1000</izz>
          </inertia>
        </inertial>
        <visual name="wall_x_neg_visual">
          <pose>-12.5 0 -0.8 0 0 0</pose>
          <geometry><box><size>0.01 16 1.6</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
            <emissive>0 0 0 1</emissive>
            <pbr>
              <metal>
                <albedo_map>model://sauvc_textures/pool_wall_long.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>0.85</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="wall_x_neg_collision">
          <pose>-12.605 0 -0.8 0 0 0</pose>
          <geometry><box><size>0.2 16.4 1.6</size></box></geometry>
        </collision>
      </link>
      <link name="wall_y_pos">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1000</mass>
          <inertia>
            <ixx>1000</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1000</iyy><iyz>0</iyz>
            <izz>1000</izz>
          </inertia>
        </inertial>
        <visual name="wall_y_pos_visual">
          <pose>0 8 -0.8 0 0 0</pose>
          <geometry><box><size>25 0.01 1.6</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
            <emissive>0 0 0 1</emissive>
            <pbr>
              <metal>
                <albedo_map>model://sauvc_textures/pool_wall_short.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>0.85</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="wall_y_pos_collision">
          <pose>0 8.105 -0.8 0 0 0</pose>
          <geometry><box><size>25 0.2 1.6</size></box></geometry>
        </collision>
      </link>
      <link name="wall_y_neg">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1000</mass>
          <inertia>
            <ixx>1000</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1000</iyy><iyz>0</iyz>
            <izz>1000</izz>
          </inertia>
        </inertial>
        <visual name="wall_y_neg_visual">
          <pose>0 -8 -0.8 0 0 0</pose>
          <geometry><box><size>25 0.01 1.6</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
            <emissive>0 0 0 1</emissive>
            <pbr>
              <metal>
                <albedo_map>model://sauvc_textures/pool_wall_short.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>0.85</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="wall_y_neg_collision">
          <pose>0 -8.105 -0.8 0 0 0</pose>
          <geometry><box><size>25 0.2 1.6</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- MARINE SNOW. Suspended particulate drifting through the beam.
         `underwater_fx` degrades every pixel by the VEHICLE's depth, so it
         cannot produce anything range-dependent -- a far wall is exactly as
         hazy as the near floor, and nothing moves between frames. Real
         particulate is the cue that is missing: it occludes, it drifts, and it
         gives a detector something to be robust to that fog cannot.
         `snow: 0` in a course's scene block turns it off. -->
    <model name="marine_snow">
      <static>true</static>
      <pose>0 0 -0.8 0 0 0</pose>
      <link name="link">
        <particle_emitter name="snow" type="box">
          <emitting>true</emitting>
          <size>25 16 1.6</size>
          <particle_size>0.012 0.012 0.012</particle_size>
          <lifetime>18</lifetime>
          <min_velocity>0.01</min_velocity>
          <max_velocity>0.05</max_velocity>
          <scale_rate>0</scale_rate>
          <rate>60</rate>
          <color_start>0.85 0.88 0.85 0.30</color_start>
          <color_end>0.75 0.80 0.78 0.05</color_end>
          <topic>marine_snow</topic>
        </particle_emitter>
      </link>
    </model>
    <!-- ===================== PROPS ===================== -->
    <include>
      <uri>model://sauvc_starting_zone</uri>
      <name>start</name>
      <pose>-11.8 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://sauvc_final_gate</uri>
      <name>gate</name>
      <pose>-4.8 0 -1.4464 0 0.0319891 0</pose>
    </include>

    <include>
      <uri>model://sauvc_orange_flare</uri>
      <name>flare_obstacle</name>
      <pose>-6.8 0 -1.3824 0 0.0319891 0</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/waves</uri>
      <name>water_surface</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- ===================== VEHICLE ===================== -->
    <include>
      <uri>model://duburi_heavy</uri>
      <name>duburi</name>
      <pose>-11.8 0 -0.3 0 0 0</pose>
    </include>

  </world>
</sdf>
