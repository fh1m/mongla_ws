           inflow rises, the blade's angle of attack drops and thrust falls.
           This is why a real vehicle creeps toward its top speed while the sim
           snapped to it.
           thrust = rho * D^4 * Ct * |w|w * (alpha_1 + alpha_2 * J), with
           J the advance ratio built from wake_fraction. -->
      <wake_fraction>0.2</wake_fraction>
      <alpha_1>0.02</alpha_1>
      <alpha_2>-0.012</alpha_2>
    </plugin>

    <plugin
        filename="gz-sim-thruster-system"
        name="gz::sim::systems::Thruster">
      <namespace>duburi_heavy</namespace>
      <joint_name>thruster7_joint</joint_name>
      <!-- Reverse spin to balance torque -->
      <fluid_density>1000.0</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>False</use_angvel_cmd>
      <!-- WAKE. Blue Robotics' T200 data is BOLLARD PULL -- thrust with the
           vehicle held still -- so without this the propeller makes the same
           force at 0.7 m/s as it does at rest. It does not: as the hull moves,
           inflow rises, the blade's angle of attack drops and thrust falls.
           This is why a real vehicle creeps toward its top speed while the sim
           snapped to it.
           thrust = rho * D^4 * Ct * |w|w * (alpha_1 + alpha_2 * J), with
           J the advance ratio built from wake_fraction. -->
      <wake_fraction>0.2</wake_fraction>
      <alpha_1>0.02</alpha_1>
      <alpha_2>-0.012</alpha_2>
    </plugin>

    <plugin
        filename="gz-sim-thruster-system"
        name="gz::sim::systems::Thruster">
      <namespace>duburi_heavy</namespace>
      <joint_name>thruster8_joint</joint_name>
      <!-- NO <thrust_coefficient> HERE, deliberately. It and the alpha_* pair
           are MUTUALLY EXCLUSIVE: with both set, gz-sim logs
             "The [alpha_2] value will be ignored as a [thrust_coefficient]
              was also defined through the SDF file"
           and the wake model does nothing. That is exactly what shipped last
           round -- velocity-dependent thrust written up as done, silently
           inert, because it was never measured afterwards.

           Ct is now computed each step as alpha_1 + alpha_2 * J. alpha_1 is
           our previous static Ct, so stationary thrust is unchanged and the
           only new behaviour is the falloff with speed.

           COST: counter-rotation was expressed as a negative Ct, and that is
           lost. It is spin direction only -- this plugin applies no reaction
           torque (checked in the binary), so no force or moment changes. The
           propellers now all spin the same way on screen. -->
      <fluid_density>1000.0</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>False</use_angvel_cmd>
      <!-- WAKE. Blue Robotics' T200 data is BOLLARD PULL -- thrust with the
           vehicle held still -- so without this the propeller makes the same
           force at 0.7 m/s as it does at rest. It does not: as the hull moves,
           inflow rises, the blade's angle of attack drops and thrust falls.
           This is why a real vehicle creeps toward its top speed while the sim
           snapped to it.
           thrust = rho * D^4 * Ct * |w|w * (alpha_1 + alpha_2 * J), with
           J the advance ratio built from wake_fraction. -->
      <wake_fraction>0.2</wake_fraction>
      <alpha_1>0.02</alpha_1>
      <alpha_2>-0.012</alpha_2>
    </plugin>

    <!-- ArduSub link. type=COMMAND means this plugin does not actuate the joint
         itself; it republishes a gz.msgs.Double onto cmd_topic, which the
         Thruster plugin above consumes. Chain is:
           ArduSub -> PWM over UDP 9002 -> here -> cmd_thrust_linear
                   -> duburi_sim_bridge/t200_curve -> cmd_thrust -> joint force.

         The topic is cmd_thrust_LINEAR because this plugin can only apply an
         affine map, `(normalised_pwm + offset) * multiplier`. A real T200 has a
         +/-28 us deadband, makes only ~78 % of its forward thrust in reverse,
         and follows a quadratic -- a straight line is out by 12 N, 24 % of full
         thrust, and worst exactly where fine corrections live. t200_curve
         reshapes it against Blue Robotics' published performance data.

         WITHOUT that node running the thrusters receive NOTHING: this topic
         has no other subscriber. duburi_sim's `sim` starts it; if you launch
         sim.launch.py by hand, pass t200:=true (the default). -->
    <plugin name="ArduPilotPlugin" filename="libArduPilotPlugin.so">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>

      <!-- Gazebo body frame (x-forward, y-left, z-up)
           to ArduPilot body frame (x-forward, y-right, z-down) -->
      <modelXYZToAirplaneXForwardZDown>0 0 0 3.141593 0 0</modelXYZToAirplaneXForwardZDown>

      <!-- Gazebo world frame (ENU) to ArduPilot world frame (NED) -->
      <gazeboXYZToNED>0 0 0 3.141593 0 1.570796</gazeboXYZToNED>

      <imuName>imu_sensor</imuName>

      <control channel="0">
        <jointName>thruster1_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/duburi_heavy/joint/thruster1_joint/cmd_thrust_linear</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="1">
        <jointName>thruster2_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/duburi_heavy/joint/thruster2_joint/cmd_thrust_linear</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="2">
        <jointName>thruster3_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/duburi_heavy/joint/thruster3_joint/cmd_thrust_linear</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="3">
        <jointName>thruster4_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/duburi_heavy/joint/thruster4_joint/cmd_thrust_linear</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="4">
        <jointName>thruster5_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/duburi_heavy/joint/thruster5_joint/cmd_thrust_linear</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="5">
        <jointName>thruster6_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/duburi_heavy/joint/thruster6_joint/cmd_thrust_linear</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="6">
        <jointName>thruster7_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/duburi_heavy/joint/thruster7_joint/cmd_thrust_linear</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="7">
        <jointName>thruster8_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/duburi_heavy/joint/thruster8_joint/cmd_thrust_linear</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
    </plugin>

  </model>
</sdf>
