<?xml version='1.0' encoding='UTF-8'?>
<!--
  TEMPLATE - do not edit the generated model.sdf, edit this file and configs.yaml
  then run:
    scripts/generate_model.py \
      models/duburi_heavy/model.sdf.in \
      models/duburi_heavy/model.sdf \
      models/duburi_heavy/configs.yaml

  Duburi 4.5 simulator proxy. Physically this is the BlueROV2 Heavy hull, chosen
  because it shares the vectored_6dof eight-thruster frame with Duburi 4.5, which
  is what ArduSub actually mixes against. The octagonal aluminium hull is a V0.2
  concern.

  Derived from bluerov2_gz by Clyde McQueen (MIT). See ATTRIBUTION.md.
-->
<!-- 1.11, not the 1.6 bluerov2_gz uses: //inertial/fluid_added_mass arrived in
     1.10 and is silently dropped by the converter from anything older. -->
<sdf version="1.11">
  <model name="duburi_heavy">
    <pose>0 0 0 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <pose>0.0 0.0 0.0 0 0 0</pose>
        <mass>13.5</mass>
        <inertia>
          <ixx>0.26</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.23</iyy>
          <iyz>0</iyz>
          <izz>0.37</izz>
        </inertia>

        <!-- Added mass, folded into the spatial inertia by dartsim. This does
             NOT belong in the Hydrodynamics plugin below: that applies added
             mass explicitly and diverges once a term exceeds the rigid-body
             mass, which heave does here by 40%. Positive by definition; the
             plugin's equivalent tags are negative. Off-diagonal terms are zero
             because the identified model is diagonal. -->
        <fluid_added_mass>
          <xx>6.356674</xx>
          <yy>7.1206</yy>
          <zz>18.686327</zz>
          <pp>0.185766</pp>
          <qq>0.134823</qq>
          <rr>0.22151</rr>
        </fluid_added_mass>
      </inertial>

      <visual name="base_link_visual">
        <geometry>
          <mesh>
            <uri>model://duburi_heavy/meshes/duburi_heavy.dae</uri>
            <scale>0.025 0.025 0.025</scale>
          </mesh>
        </geometry>
      </visual>

      <!-- This box is NOT the hull. Its volume times fluid_density equals the
           displaced mass, which is what gz-sim-buoyancy-system integrates. The
           generator derives collision_z from mass, bounding box and density, so
           never hand-edit it. The offset between the inertial pose (centre of
           mass) and this pose (centre of volume) is the entire source of the
           vehicle's righting moment in roll and pitch. -->
      <collision name="base_link_collision">
        <pose>0.0 0.0 0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>0.457 0.575 0.051755</size>
          </box>
        </geometry>
      </collision>

      <!-- IMU gyro and accel are consumed by ArduSub over the JSON link. The
           1000 Hz rate must be at least the SITL loop rate. -->
      <sensor name="imu_sensor" type="imu">
        <!-- Gazebo body frame (x-forward, y-left, z-up)
             to ArduPilot body frame (x-forward, y-right, z-down) -->
        <pose>0 0 0 3.141593 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000.0</update_rate>
      </sensor>

      <!-- Doppler Velocity Log, downward-looking 4-beam janus array. Stands in
           for the Nortek Nucleus1000 on the real hull, so `yaw_source=sim_dvl`
           gives duburi_ws real bottom-track position feedback and the DVL
           distance verbs close their loop in sim instead of dead-reckoning.

           ON base_link ON PURPOSE, not on a child link of its own.
           gz-sim only populates a link's velocity components when something
           enables them, and the OdometryPublisher below does that for the
           canonical link only. Mounted on its own child link the sensor still
           reported bottom lock and a plausible range but a velocity of ~0.009
           m/s while Gazebo's own odometry read 0.698 m/s: measured, not
           guessed. The reference world at
           /usr/share/gz/gz-sim8/worlds/dvl_world.sdf says the same thing with
           its element_id="base_link": that attribute is placement, not just
           include-override syntax. Move this to a child link and it silently
           reads zero again.

           Needs gz::sim::systems::DopplerVelocityLogSystem in the world, which
           duburi_sim_worlds/templates/world.sdf.template loads. Without it the
           sensor loads and never publishes, the same silent trap as the
           cameras and gz-sim-sensors-system. -->
      <sensor name="dvl" type="custom" gz:type="dvl">
        <!-- Offset to the hull underside; 180 deg roll points the array down. -->
        <pose degrees="true">0.0 0.0 -0.1 0 0 180</pose>
        <always_on>1</always_on>
        <update_rate>8.0</update_rate>
        <topic>dvl/velocity</topic>
        <gz:dvl>
          <type>phased_array</type>
          <arrangement degrees="true">
            <beam id="1">
              <aperture>2</aperture><rotation>45</rotation><tilt>30</tilt>
            </beam>
            <beam>
              <aperture>2</aperture><rotation>135</rotation><tilt>30</tilt>
            </beam>
            <beam>
              <aperture>2</aperture><rotation>-45</rotation><tilt>30</tilt>
            </beam>
            <beam>
              <aperture>2</aperture><rotation>-135</rotation><tilt>30</tilt>
            </beam>
          </arrangement>
          <tracking>
            <bottom_mode>
              <when>best</when>
              <noise type="gaussian">
                <stddev>0.002</stddev>
              </noise>
              <!-- Draws the four beams in the GAZEBO GUI. NOT cheap, despite
                   what this comment used to claim: these are debug visuals on
                   the shared Ogre2 render thread, and enabling them takes the
                   cameras from 12.75 Hz to 2.83 Hz and multiplies frame jitter
                   by 76x (see DVL_DEFAULTS in generate_model.py for the
                   measurement). dvl_bridge.py publishes the same beams as an
                   RViz MarkerArray, which costs nothing. Default off. -->
              <visualize>false</visualize>
            </bottom_mode>
          </tracking>
          <resolution>0.01</resolution>
          <!-- The SAUVC pool is 1.6 m deep, so the useful altitude band is well
               under a metre: minimum_range matters far more than maximum. -->
          <maximum_range>50.0</maximum_range>
          <minimum_range>0.1</minimum_range>
          <!-- ENU to SFM -->
          <reference_frame>0 0 0 0 0 -1.570796</reference_frame>
        </gz:dvl>
      </sensor>
    </link>

    <!-- ======================= CAMERAS =======================
         Bridged to /duburi/sim/{front,bottom}_camera/image_raw, which is what
         the sim_front and sim_bottom profiles in duburi_vision/config/cameras.yaml
         subscribe to. The 640x480 resolution is fixed by those profiles.

         These need gz-sim-sensors-system with the ogre2 render engine loaded in
         the world, otherwise they silently never publish.
    -->
    <link name="front_camera_link">
      <pose>0.2 0.0 0.0 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz>
        </inertia>
      </inertial>
      <!-- No collision geometry on purpose: a collision here would add displaced
           volume and break the buoyancy budget computed above. -->
      <sensor name="front_camera" type="camera">
        <always_on>1</always_on>
        <update_rate>30.0</update_rate>
        <visualize>false</visualize>
        <topic>front_camera</topic>
        <camera name="front_camera">
          <!-- Without this both cameras default to a bare /camera_info and
               stomp on each other. -->
          <camera_info_topic>front_camera/camera_info</camera_info_topic>
          <horizontal_fov>1.396</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <!-- Stands in for water turbidity; beyond this the pool fades out. -->
            <far>30.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
          <optical_frame_id>front_camera_link_optical</optical_frame_id>
        </camera>
      </sensor>

      <!-- Ground-truth 2D boxes, from the GPU, for dataset labelling.
           Occlusion- and truncation-correct: this replaced a geometric AABB
           projector that gave a full box to a crate hidden behind another one.

           A box is emitted ONLY for a model carrying a <label>, set by the
           gz-sim-label-system plugin that prop_library.model() writes. An
           unlabelled prop is silently absent from every annotation.

           Same intrinsics as the colour camera above -- the boxes have to be
           in the same image frame as the pixels they annotate, so the two
           sensors share every camera token rather than getting their own. -->

      <sensor name="front_boxes" type="boundingbox_camera">
        <always_on>1</always_on>
        <update_rate>30.0</update_rate>
        <visualize>false</visualize>
        <topic>front_boxes</topic>
        <camera name="front_boxes">
          <box_type>2d</box_type>
          <horizontal_fov>1.396</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>30.0</far>
          </clip>
          <optical_frame_id>front_camera_link_optical</optical_frame_id>
        </camera>
      </sensor>
    </link>

    <joint name="front_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_camera_link</child>
    </joint>

    <link name="bottom_camera_link">
      <!-- Pitched 90 degrees down. -->
      <pose>0.0 0.0 -0.1 0 1.570796 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz>
        </inertia>
      </inertial>
      <sensor name="bottom_camera" type="camera">
        <always_on>1</always_on>
        <update_rate>30.0</update_rate>
        <visualize>false</visualize>
        <topic>bottom_camera</topic>
        <camera name="bottom_camera">
          <camera_info_topic>bottom_camera/camera_info</camera_info_topic>
          <horizontal_fov>1.396</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>30.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
          <optical_frame_id>bottom_camera_link_optical</optical_frame_id>
        </camera>
      </sensor>

      <!-- Ground-truth 2D boxes, from the GPU, for dataset labelling.
           Occlusion- and truncation-correct: this replaced a geometric AABB
           projector that gave a full box to a crate hidden behind another one.

           A box is emitted ONLY for a model carrying a <label>, set by the
           gz-sim-label-system plugin that prop_library.model() writes. An
           unlabelled prop is silently absent from every annotation.

           Same intrinsics as the colour camera above -- the boxes have to be
           in the same image frame as the pixels they annotate, so the two
           sensors share every camera token rather than getting their own. -->

      <sensor name="bottom_boxes" type="boundingbox_camera">
        <always_on>1</always_on>
        <update_rate>30.0</update_rate>
        <visualize>false</visualize>
        <topic>bottom_boxes</topic>
        <camera name="bottom_boxes">
          <box_type>2d</box_type>
          <horizontal_fov>1.396</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>30.0</far>
          </clip>
          <optical_frame_id>bottom_camera_link_optical</optical_frame_id>
        </camera>
      </sensor>
    </link>

    <joint name="bottom_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>bottom_camera_link</child>
    </joint>

    <!-- Hydrodynamics: Fossen model, applied by stock gz-sim.
         Also subscribes to /model/duburi_heavy/ocean_current for a
         gz.msgs.Vector3d, which is the hook for pool disturbance injection. -->
    <plugin
        filename="gz-sim-hydrodynamics-system"
        name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <water_density>1000.0</water_density>
      <!-- Added mass is deliberately left at the zero default here; it lives in
           base_link's <fluid_added_mass> instead. Setting it in both places
           double-counts, and setting it only here is unstable. -->
      <!-- First order stability derivative: -->
      <xU>-13.7</xU>
      <yV>0.0</yV>
      <zW>-33.0</zW>
      <kP>0.0</kP>
      <mQ>-0.8</mQ>
      <nR>0.0</nR>
      <!-- Second order stability derivative: -->
      <xUabsU>-141.0</xUabsU>
      <yVabsV>-217.0</yVabsV>
      <zWabsW>-190.0</zWabsW>
      <kPabsP>-1.192</kPabsP>
      <mQabsQ>-0.47</mQabsQ>
      <nRabsR>-1.5</nRabsR>
    </plugin>

    <!-- Ground truth pose and twist, for scoring and for grading the EKF.
         Debug only; the autonomy stack must never consume this. -->
    <plugin
        filename="gz-sim-odometry-publisher-system"
        name="gz::sim::systems::OdometryPublisher">
      <odom_frame>duburi_heavy/odom</odom_frame>
      <robot_base_frame>duburi_heavy/base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>50.0</odom_publish_frequency>
    </plugin>

    <link name="thruster1">
      <pose>0.14 -0.092 0.0 -1.570796 1.570796 -0.785398</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 -1.570796 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://duburi_heavy/meshes/t200_ccw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.002</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster2">
      <pose>0.14 0.092 0.0 -1.570796 1.570796 -2.356194</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 -1.570796 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://duburi_heavy/meshes/t200_ccw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.002</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster3">
      <pose>-0.14 -0.092 0.0 -1.570796 1.570796 0.785398</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://duburi_heavy/meshes/t200_cw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.002</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster4">
      <pose>-0.14 0.092 0.0 -1.570796 1.570796 2.356194</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://duburi_heavy/meshes/t200_cw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.002</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster5">
      <pose>0.118 -0.215 0.064 0 0 0</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 -1.570796 0 1.570796</pose>
        <geometry>
          <mesh>
            <uri>model://duburi_heavy/meshes/t200_ccw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.002</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster6">
      <pose>0.118 0.215 0.064 0 0 0</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 1.570796 0 1.570796</pose>
        <geometry>
          <mesh>
            <uri>model://duburi_heavy/meshes/t200_cw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.002</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster7">
      <pose>-0.118 -0.215 0.064 0 0 0</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 1.570796 0 1.570796</pose>
        <geometry>
          <mesh>
            <uri>model://duburi_heavy/meshes/t200_cw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.002</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster8">
      <pose>-0.118 0.215 0.064 0 0 0</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 -1.570796 0 1.570796</pose>
        <geometry>
          <mesh>
            <uri>model://duburi_heavy/meshes/t200_ccw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>0.002</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="thruster1_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster1</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster2_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster2</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster3_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster3</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster4_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster4</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster5_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster5</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster6_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster6</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster7_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster7</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster8_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster8</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <!-- Counter-rotation USED to be a negative thrust_coefficient here. That
         tag is gone: it is mutually exclusive with the alpha_* wake model, and
         with both present gz-sim silently ignored the wake.
         Nothing physical is lost -- this plugin applies no reaction torque, so
         the sign only ever set which way the propeller mesh spun on screen. -->
    <plugin
        filename="gz-sim-thruster-system"
        name="gz::sim::systems::Thruster">
      <namespace>duburi_heavy</namespace>
      <joint_name>thruster1_joint</joint_name>
      <!-- NO <thrust_coefficient> HERE, deliberately. It and the alpha_* pair
           are MUTUALLY EXCLUSIVE: with both set, gz-sim logs
             "The [alpha_2] value will be ignored as a [thrust_coefficient]
              was also defined through the SDF file"
           and the wake model does nothing. That is exactly what shipped last
           round -- velocity-dependent thrust written up as done, silently
           inert, because it was never measured afterwards.

           Ct is now computed each step as alpha_1 + alpha_2 * J. alpha_1 is
           our previous static Ct, so stationary thrust is unchanged and the
           only new behaviour is the falloff with speed.

           COST: counter-rotation was expressed as a negative Ct, and that is
           lost. It is spin direction only -- this plugin applies no reaction
           torque (checked in the binary), so no force or moment changes. The
           propellers now all spin the same way on screen. -->
      <fluid_density>1000.0</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>False</use_angvel_cmd>
      <!-- WAKE. Blue Robotics' T200 data is BOLLARD PULL -- thrust with the
           vehicle held still -- so without this the propeller makes the same
           force at 0.7 m/s as it does at rest. It does not: as the hull moves,
           inflow rises, the blade's angle of attack drops and thrust falls.
           This is why a real vehicle creeps toward its top speed while the sim
           snapped to it.
           thrust = rho * D^4 * Ct * |w|w * (alpha_1 + alpha_2 * J), with
           J the advance ratio built from wake_fraction. -->
      <wake_fraction>0.2</wake_fraction>
      <alpha_1>0.02</alpha_1>
      <alpha_2>-0.012</alpha_2>
    </plugin>

    <plugin
        filename="gz-sim-thruster-system"
        name="gz::sim::systems::Thruster">
      <namespace>duburi_heavy</namespace>
      <joint_name>thruster2_joint</joint_name>
      <!-- NO <thrust_coefficient> HERE, deliberately. It and the alpha_* pair
           are MUTUALLY EXCLUSIVE: with both set, gz-sim logs
             "The [alpha_2] value will be ignored as a [thrust_coefficient]
              was also defined through the SDF file"
           and the wake model does nothing. That is exactly what shipped last
           round -- velocity-dependent thrust written up as done, silently
           inert, because it was never measured afterwards.

           Ct is now computed each step as alpha_1 + alpha_2 * J. alpha_1 is
           our previous static Ct, so stationary thrust is unchanged and the
           only new behaviour is the falloff with speed.

           COST: counter-rotation was expressed as a negative Ct, and that is
           lost. It is spin direction only -- this plugin applies no reaction
           torque (checked in the binary), so no force or moment changes. The
           propellers now all spin the same way on screen. -->
      <fluid_density>1000.0</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>False</use_angvel_cmd>
      <!-- WAKE. Blue Robotics' T200 data is BOLLARD PULL -- thrust with the
           vehicle held still -- so without this the propeller makes the same
           force at 0.7 m/s as it does at rest. It does not: as the hull moves,
           inflow rises, the blade's angle of attack drops and thrust falls.
           This is why a real vehicle creeps toward its top speed while the sim
           snapped to it.
           thrust = rho * D^4 * Ct * |w|w * (alpha_1 + alpha_2 * J), with
           J the advance ratio built from wake_fraction. -->
      <wake_fraction>0.2</wake_fraction>
      <alpha_1>0.02</alpha_1>
      <alpha_2>-0.012</alpha_2>
    </plugin>

    <plugin
        filename="gz-sim-thruster-system"
        name="gz::sim::systems::Thruster">
      <namespace>duburi_heavy</namespace>
      <joint_name>thruster3_joint</joint_name>
      <!-- Reverse spin to balance torque -->
      <fluid_density>1000.0</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>False</use_angvel_cmd>
      <!-- WAKE. Blue Robotics' T200 data is BOLLARD PULL -- thrust with the
           vehicle held still -- so without this the propeller makes the same
           force at 0.7 m/s as it does at rest. It does not: as the hull moves,
           inflow rises, the blade's angle of attack drops and thrust falls.
           This is why a real vehicle creeps toward its top speed while the sim
           snapped to it.
           thrust = rho * D^4 * Ct * |w|w * (alpha_1 + alpha_2 * J), with
           J the advance ratio built from wake_fraction. -->
      <wake_fraction>0.2</wake_fraction>
      <alpha_1>0.02</alpha_1>
      <alpha_2>-0.012</alpha_2>
    </plugin>

    <plugin
        filename="gz-sim-thruster-system"
        name="gz::sim::systems::Thruster">
      <namespace>duburi_heavy</namespace>
      <joint_name>thruster4_joint</joint_name>
      <!-- Reverse spin to balance torque -->
      <fluid_density>1000.0</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>False</use_angvel_cmd>
      <!-- WAKE. Blue Robotics' T200 data is BOLLARD PULL -- thrust with the
           vehicle held still -- so without this the propeller makes the same
           force at 0.7 m/s as it does at rest. It does not: as the hull moves,
           inflow rises, the blade's angle of attack drops and thrust falls.
           This is why a real vehicle creeps toward its top speed while the sim
           snapped to it.
           thrust = rho * D^4 * Ct * |w|w * (alpha_1 + alpha_2 * J), with
           J the advance ratio built from wake_fraction. -->
      <wake_fraction>0.2</wake_fraction>
      <alpha_1>0.02</alpha_1>
      <alpha_2>-0.012</alpha_2>
    </plugin>

    <plugin
        filename="gz-sim-thruster-system"
        name="gz::sim::systems::Thruster">
      <namespace>duburi_heavy</namespace>
      <joint_name>thruster5_joint</joint_name>
      <!-- NO <thrust_coefficient> HERE, deliberately. It and the alpha_* pair
           are MUTUALLY EXCLUSIVE: with both set, gz-sim logs
             "The [alpha_2] value will be ignored as a [thrust_coefficient]
              was also defined through the SDF file"
           and the wake model does nothing. That is exactly what shipped last
           round -- velocity-dependent thrust written up as done, silently
           inert, because it was never measured afterwards.

           Ct is now computed each step as alpha_1 + alpha_2 * J. alpha_1 is
           our previous static Ct, so stationary thrust is unchanged and the
           only new behaviour is the falloff with speed.

           COST: counter-rotation was expressed as a negative Ct, and that is
           lost. It is spin direction only -- this plugin applies no reaction
           torque (checked in the binary), so no force or moment changes. The
           propellers now all spin the same way on screen. -->
      <fluid_density>1000.0</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>False</use_angvel_cmd>
      <!-- WAKE. Blue Robotics' T200 data is BOLLARD PULL -- thrust with the
           vehicle held still -- so without this the propeller makes the same
           force at 0.7 m/s as it does at rest. It does not: as the hull moves,
           inflow rises, the blade's angle of attack drops and thrust falls.
           This is why a real vehicle creeps toward its top speed while the sim
           snapped to it.
           thrust = rho * D^4 * Ct * |w|w * (alpha_1 + alpha_2 * J), with
           J the advance ratio built from wake_fraction. -->
      <wake_fraction>0.2</wake_fraction>
      <alpha_1>0.02</alpha_1>
      <alpha_2>-0.012</alpha_2>
    </plugin>

    <plugin
        filename="gz-sim-thruster-system"
        name="gz::sim::systems::Thruster">
      <namespace>duburi_heavy</namespace>
      <joint_name>thruster6_joint</joint_name>
      <!-- Reverse spin to balance torque -->
      <fluid_density>1000.0</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
