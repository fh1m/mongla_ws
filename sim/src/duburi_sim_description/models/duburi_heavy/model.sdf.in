<?xml version='1.0' encoding='UTF-8'?>
<!--
  TEMPLATE - do not edit the generated model.sdf, edit this file and configs.yaml
  then run:
    scripts/generate_model.py \
      models/duburi_heavy/model.sdf.in \
      models/duburi_heavy/model.sdf \
      models/duburi_heavy/configs.yaml

  Duburi 4.5 simulator proxy. Physically this is the BlueROV2 Heavy hull, chosen
  because it shares the vectored_6dof eight-thruster frame with Duburi 4.5, which
  is what ArduSub actually mixes against. The octagonal aluminium hull is a V0.2
  concern.

  Derived from bluerov2_gz by Clyde McQueen (MIT). See ATTRIBUTION.md.
-->
<!-- 1.11, not the 1.6 bluerov2_gz uses: //inertial/fluid_added_mass arrived in
     1.10 and is silently dropped by the converter from anything older. -->
<sdf version="1.11">
  <model name=@model_name>
    <pose>0 0 0 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <pose>@center_of_mass_x @center_of_mass_y @center_of_mass_z 0 0 0</pose>
        <mass>@mass</mass>
        <inertia>
          <ixx>@ixx</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>@iyy</iyy>
          <iyz>0</iyz>
          <izz>@izz</izz>
        </inertia>

        <!-- Added mass, folded into the spatial inertia by dartsim. This does
             NOT belong in the Hydrodynamics plugin below: that applies added
             mass explicitly and diverges once a term exceeds the rigid-body
             mass, which heave does here by 40%. Positive by definition; the
             plugin's equivalent tags are negative. Off-diagonal terms are zero
             because the identified model is diagonal. -->
        <fluid_added_mass>
          <xx>@am_xx</xx>
          <yy>@am_yy</yy>
          <zz>@am_zz</zz>
          <pp>@am_pp</pp>
          <qq>@am_qq</qq>
          <rr>@am_rr</rr>
        </fluid_added_mass>
      </inertial>

      <visual name="base_link_visual">
        <geometry>
          <mesh>
            <uri>model://duburi_heavy/meshes/duburi_heavy.dae</uri>
            <scale>0.025 0.025 0.025</scale>
          </mesh>
        </geometry>
      </visual>

      <!-- This box is NOT the hull. Its volume times fluid_density equals the
           displaced mass, which is what gz-sim-buoyancy-system integrates. The
           generator derives collision_z from mass, bounding box and density, so
           never hand-edit it. The offset between the inertial pose (centre of
           mass) and this pose (centre of volume) is the entire source of the
           vehicle's righting moment in roll and pitch. -->
      <collision name="base_link_collision">
        <pose>@center_of_volume_x @center_of_volume_y @center_of_volume_z 0 0 0</pose>
        <geometry>
          <box>
            <size>@collision_x @collision_y @collision_z</size>
          </box>
        </geometry>
      </collision>

      <!-- IMU gyro and accel are consumed by ArduSub over the JSON link. The
           1000 Hz rate must be at least the SITL loop rate. -->
      <sensor name="imu_sensor" type="imu">
        <!-- Gazebo body frame (x-forward, y-left, z-up)
             to ArduPilot body frame (x-forward, y-right, z-down) -->
        <pose>0 0 0 @d180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000.0</update_rate>
      </sensor>

      <!-- Doppler Velocity Log, downward-looking 4-beam janus array. Stands in
           for the Nortek Nucleus1000 on the real hull, so `yaw_source=sim_dvl`
           gives duburi_ws real bottom-track position feedback and the DVL
           distance verbs close their loop in sim instead of dead-reckoning.

           ON base_link ON PURPOSE, not on a child link of its own.
           gz-sim only populates a link's velocity components when something
           enables them, and the OdometryPublisher below does that for the
           canonical link only. Mounted on its own child link the sensor still
           reported bottom lock and a plausible range but a velocity of ~0.009
           m/s while Gazebo's own odometry read 0.698 m/s: measured, not
           guessed. The reference world at
           /usr/share/gz/gz-sim8/worlds/dvl_world.sdf says the same thing with
           its element_id="base_link": that attribute is placement, not just
           include-override syntax. Move this to a child link and it silently
           reads zero again.

           Needs gz::sim::systems::DopplerVelocityLogSystem in the world, which
           duburi_sim_worlds/templates/world.sdf.template loads. Without it the
           sensor loads and never publishes, the same silent trap as the
           cameras and gz-sim-sensors-system. -->
      <sensor name="dvl" type="custom" gz:type="dvl">
        <!-- Offset to the hull underside; 180 deg roll points the array down. -->
        <pose degrees="true">@dvl_x @dvl_y @dvl_z 0 0 180</pose>
        <always_on>1</always_on>
        <update_rate>@dvl_update_rate</update_rate>
        <topic>dvl/velocity</topic>
        <gz:dvl>
          <type>phased_array</type>
          <arrangement degrees="true">
            <beam id="1">
              <aperture>2</aperture><rotation>45</rotation><tilt>30</tilt>
            </beam>
            <beam>
              <aperture>2</aperture><rotation>135</rotation><tilt>30</tilt>
            </beam>
            <beam>
              <aperture>2</aperture><rotation>-45</rotation><tilt>30</tilt>
            </beam>
            <beam>
              <aperture>2</aperture><rotation>-135</rotation><tilt>30</tilt>
            </beam>
          </arrangement>
          <tracking>
            <bottom_mode>
              <when>best</when>
              <noise type="gaussian">
                <stddev>@dvl_noise_stddev</stddev>
              </noise>
              <!-- Draws the four beams in the GAZEBO GUI. NOT cheap, despite
                   what this comment used to claim: these are debug visuals on
                   the shared Ogre2 render thread, and enabling them takes the
                   cameras from 12.75 Hz to 2.83 Hz and multiplies frame jitter
                   by 76x (see DVL_DEFAULTS in generate_model.py for the
                   measurement). dvl_bridge.py publishes the same beams as an
                   RViz MarkerArray, which costs nothing. Default off. -->
              <visualize>@dvl_visualize_beams</visualize>
            </bottom_mode>
          </tracking>
          <resolution>@dvl_resolution</resolution>
          <!-- The SAUVC pool is 1.6 m deep, so the useful altitude band is well
               under a metre: minimum_range matters far more than maximum. -->
          <maximum_range>@dvl_maximum_range</maximum_range>
          <minimum_range>@dvl_minimum_range</minimum_range>
          <!-- ENU to SFM -->
          <reference_frame>0 0 0 0 0 -1.570796</reference_frame>
        </gz:dvl>
      </sensor>
    </link>

    <!-- ======================= CAMERAS =======================
         Bridged to /duburi/sim/{front,bottom}_camera/image_raw, which is what
         the sim_front and sim_bottom profiles in duburi_vision/config/cameras.yaml
         subscribe to. The 640x480 resolution is fixed by those profiles.

         These need gz-sim-sensors-system with the ogre2 render engine loaded in
         the world, otherwise they silently never publish.
    -->
    <link name="front_camera_link">
      <pose>@front_camera_x @front_camera_y @front_camera_z 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz>
        </inertia>
      </inertial>
      <!-- No collision geometry on purpose: a collision here would add displaced
           volume and break the buoyancy budget computed above. -->
      <sensor name="front_camera" type="camera">
        <always_on>1</always_on>
        <update_rate>@camera_update_rate</update_rate>
        <visualize>false</visualize>
        <topic>front_camera</topic>
        <camera name="front_camera">
          <!-- Without this both cameras default to a bare /camera_info and
               stomp on each other. -->
          <camera_info_topic>front_camera/camera_info</camera_info_topic>
          <horizontal_fov>@camera_hfov</horizontal_fov>
          <image>
            <width>@camera_width</width>
            <height>@camera_height</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <!-- Stands in for water turbidity; beyond this the pool fades out. -->
            <far>@camera_far_clip</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>@camera_noise_stddev</stddev>
          </noise>
          <optical_frame_id>front_camera_link_optical</optical_frame_id>
        </camera>
      </sensor>
    </link>

    <joint name="front_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_camera_link</child>
    </joint>

    <link name="bottom_camera_link">
      <!-- Pitched 90 degrees down. -->
      <pose>@bottom_camera_x @bottom_camera_y @bottom_camera_z 0 @d90 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz>
        </inertia>
      </inertial>
      <sensor name="bottom_camera" type="camera">
        <always_on>1</always_on>
        <update_rate>@camera_update_rate</update_rate>
        <visualize>false</visualize>
        <topic>bottom_camera</topic>
        <camera name="bottom_camera">
          <camera_info_topic>bottom_camera/camera_info</camera_info_topic>
          <horizontal_fov>@camera_hfov</horizontal_fov>
          <image>
            <width>@camera_width</width>
            <height>@camera_height</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>@camera_far_clip</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>@camera_noise_stddev</stddev>
          </noise>
          <optical_frame_id>bottom_camera_link_optical</optical_frame_id>
        </camera>
      </sensor>
    </link>

    <joint name="bottom_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>bottom_camera_link</child>
    </joint>

    <!-- Hydrodynamics: Fossen model, applied by stock gz-sim.
         Also subscribes to /model/@model_name_plain/ocean_current for a
         gz.msgs.Vector3d, which is the hook for pool disturbance injection. -->
    <plugin
        filename="gz-sim-hydrodynamics-system"
        name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <water_density>@fluid_density</water_density>
      <!-- Added mass is deliberately left at the zero default here; it lives in
           base_link's <fluid_added_mass> instead. Setting it in both places
           double-counts, and setting it only here is unstable. -->
      <!-- First order stability derivative: -->
      <xU>@xU</xU>
      <yV>@yV</yV>
      <zW>@zW</zW>
      <kP>@kP</kP>
      <mQ>@mQ</mQ>
      <nR>@nR</nR>
      <!-- Second order stability derivative: -->
      <xUabsU>@xUabsU</xUabsU>
      <yVabsV>@yVabsV</yVabsV>
      <zWabsW>@zWabsW</zWabsW>
      <kPabsP>@kPabsP</kPabsP>
      <mQabsQ>@mQabsQ</mQabsQ>
      <nRabsR>@nRabsR</nRabsR>
    </plugin>

    <!-- Ground truth pose and twist, for scoring and for grading the EKF.
         Debug only; the autonomy stack must never consume this. -->
    <plugin
        filename="gz-sim-odometry-publisher-system"
        name="gz::sim::systems::OdometryPublisher">
      <odom_frame>@model_name_plain/odom</odom_frame>
      <robot_base_frame>@model_name_plain/base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>@odom_publish_frequency</odom_publish_frequency>
    </plugin>

    <link name="thruster1">
      <pose>@thruster1_x @thruster1_y @thruster1_z -@d90 @d90 -@d45</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 -@d90 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://duburi_heavy/meshes/t200_ccw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>@propeller_mass</mass>
        <inertia>
          <ixx>@propeller_ixx</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>@propeller_iyy</iyy>
          <iyz>0</iyz>
          <izz>@propeller_izz</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster2">
      <pose>@thruster2_x @thruster2_y @thruster2_z -@d90 @d90 -@d135</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 -@d90 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://duburi_heavy/meshes/t200_ccw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>@propeller_mass</mass>
        <inertia>
          <ixx>@propeller_ixx</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>@propeller_iyy</iyy>
          <iyz>0</iyz>
          <izz>@propeller_izz</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster3">
      <pose>@thruster3_x @thruster3_y @thruster3_z -@d90 @d90 @d45</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 @d90 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://duburi_heavy/meshes/t200_cw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>@propeller_mass</mass>
        <inertia>
          <ixx>@propeller_ixx</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>@propeller_iyy</iyy>
          <iyz>0</iyz>
          <izz>@propeller_izz</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster4">
      <pose>@thruster4_x @thruster4_y @thruster4_z -@d90 @d90 @d135</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 @d90 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://duburi_heavy/meshes/t200_cw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>@propeller_mass</mass>
        <inertia>
          <ixx>@propeller_ixx</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>@propeller_iyy</iyy>
          <iyz>0</iyz>
          <izz>@propeller_izz</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster5">
      <pose>@thruster5_x @thruster5_y @thruster5_z 0 0 0</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 -@d90 0 @d90</pose>
        <geometry>
          <mesh>
            <uri>model://duburi_heavy/meshes/t200_ccw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>@propeller_mass</mass>
        <inertia>
          <ixx>@propeller_ixx</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>@propeller_iyy</iyy>
          <iyz>0</iyz>
          <izz>@propeller_izz</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster6">
      <pose>@thruster6_x @thruster6_y @thruster6_z 0 0 0</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 @d90 0 @d90</pose>
        <geometry>
          <mesh>
            <uri>model://duburi_heavy/meshes/t200_cw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>@propeller_mass</mass>
        <inertia>
          <ixx>@propeller_ixx</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>@propeller_iyy</iyy>
          <iyz>0</iyz>
          <izz>@propeller_izz</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster7">
      <pose>@thruster7_x @thruster7_y @thruster7_z 0 0 0</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 @d90 0 @d90</pose>
        <geometry>
          <mesh>
            <uri>model://duburi_heavy/meshes/t200_cw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>@propeller_mass</mass>
        <inertia>
          <ixx>@propeller_ixx</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>@propeller_iyy</iyy>
          <iyz>0</iyz>
          <izz>@propeller_izz</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster8">
      <pose>@thruster8_x @thruster8_y @thruster8_z 0 0 0</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 -@d90 0 @d90</pose>
        <geometry>
          <mesh>
            <uri>model://duburi_heavy/meshes/t200_ccw_prop.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>@propeller_mass</mass>
        <inertia>
          <ixx>@propeller_ixx</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>@propeller_iyy</iyy>
          <iyz>0</iyz>
          <izz>@propeller_izz</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="thruster1_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster1</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster2_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster2</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster3_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster3</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster4_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster4</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster5_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster5</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster6_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster6</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster7_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster7</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <joint name="thruster8_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster8</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <!-- Counter-rotation is expressed as a negative thrust_coefficient, not as a
         negative control multiplier. Signs here must stay paired with the
         ArduPilotPlugin multipliers below. -->
    <plugin
        filename="gz-sim-thruster-system"
        name="gz::sim::systems::Thruster">
      <namespace>@model_name_plain</namespace>
      <joint_name>thruster1_joint</joint_name>
      <thrust_coefficient>@thrust_coefficient</thrust_coefficient>
      <fluid_density>@fluid_density</fluid_density>
      <propeller_diameter>@propeller_diameter</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>@use_angvel_cmd</use_angvel_cmd>
    </plugin>

    <plugin
        filename="gz-sim-thruster-system"
        name="gz::sim::systems::Thruster">
      <namespace>@model_name_plain</namespace>
      <joint_name>thruster2_joint</joint_name>
      <thrust_coefficient>@thrust_coefficient</thrust_coefficient>
      <fluid_density>@fluid_density</fluid_density>
      <propeller_diameter>@propeller_diameter</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>@use_angvel_cmd</use_angvel_cmd>
    </plugin>

    <plugin
        filename="gz-sim-thruster-system"
        name="gz::sim::systems::Thruster">
      <namespace>@model_name_plain</namespace>
      <joint_name>thruster3_joint</joint_name>
      <!-- Reverse spin to balance torque -->
      <thrust_coefficient>-@thrust_coefficient</thrust_coefficient>
      <fluid_density>@fluid_density</fluid_density>
      <propeller_diameter>@propeller_diameter</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>@use_angvel_cmd</use_angvel_cmd>
    </plugin>

    <plugin
        filename="gz-sim-thruster-system"
        name="gz::sim::systems::Thruster">
      <namespace>@model_name_plain</namespace>
      <joint_name>thruster4_joint</joint_name>
      <!-- Reverse spin to balance torque -->
      <thrust_coefficient>-@thrust_coefficient</thrust_coefficient>
      <fluid_density>@fluid_density</fluid_density>
      <propeller_diameter>@propeller_diameter</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>@use_angvel_cmd</use_angvel_cmd>
    </plugin>

    <plugin
        filename="gz-sim-thruster-system"
        name="gz::sim::systems::Thruster">
      <namespace>@model_name_plain</namespace>
      <joint_name>thruster5_joint</joint_name>
      <thrust_coefficient>@thrust_coefficient</thrust_coefficient>
      <fluid_density>@fluid_density</fluid_density>
      <propeller_diameter>@propeller_diameter</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>@use_angvel_cmd</use_angvel_cmd>
    </plugin>

    <plugin
        filename="gz-sim-thruster-system"
        name="gz::sim::systems::Thruster">
      <namespace>@model_name_plain</namespace>
      <joint_name>thruster6_joint</joint_name>
      <!-- Reverse spin to balance torque -->
      <thrust_coefficient>-@thrust_coefficient</thrust_coefficient>
      <fluid_density>@fluid_density</fluid_density>
      <propeller_diameter>@propeller_diameter</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>@use_angvel_cmd</use_angvel_cmd>
    </plugin>

    <plugin
        filename="gz-sim-thruster-system"
        name="gz::sim::systems::Thruster">
      <namespace>@model_name_plain</namespace>
      <joint_name>thruster7_joint</joint_name>
      <!-- Reverse spin to balance torque -->
      <thrust_coefficient>-@thrust_coefficient</thrust_coefficient>
      <fluid_density>@fluid_density</fluid_density>
      <propeller_diameter>@propeller_diameter</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>@use_angvel_cmd</use_angvel_cmd>
    </plugin>

    <plugin
        filename="gz-sim-thruster-system"
        name="gz::sim::systems::Thruster">
      <namespace>@model_name_plain</namespace>
      <joint_name>thruster8_joint</joint_name>
      <thrust_coefficient>@thrust_coefficient</thrust_coefficient>
      <fluid_density>@fluid_density</fluid_density>
      <propeller_diameter>@propeller_diameter</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>@use_angvel_cmd</use_angvel_cmd>
    </plugin>

    <!-- ArduSub link. type=COMMAND means this plugin does not actuate the joint
         itself; it republishes a gz.msgs.Double onto cmd_topic, which the
         Thruster plugin above consumes. Chain is:
           ArduSub -> PWM over UDP 9002 -> here -> cmd_thrust -> joint force. -->
    <plugin name="ArduPilotPlugin" filename="libArduPilotPlugin.so">
      <fdm_addr>@fdm_addr</fdm_addr>
      <fdm_port_in>@fdm_port_in</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>

      <!-- Gazebo body frame (x-forward, y-left, z-up)
           to ArduPilot body frame (x-forward, y-right, z-down) -->
      <modelXYZToAirplaneXForwardZDown>0 0 0 @d180 0 0</modelXYZToAirplaneXForwardZDown>

      <!-- Gazebo world frame (ENU) to ArduPilot world frame (NED) -->
      <gazeboXYZToNED>0 0 0 @d180 0 @d90</gazeboXYZToNED>

      <imuName>imu_sensor</imuName>

      <control channel="0">
        <jointName>thruster1_joint</jointName>
        <servo_min>@servo_min</servo_min>
        <servo_max>@servo_max</servo_max>
        <type>COMMAND</type>
        <cmd_topic>@thruster1_topic</cmd_topic>
        <offset>@control_offset</offset>
        <multiplier>@ccw_control_multiplier</multiplier>
      </control>
      <control channel="1">
        <jointName>thruster2_joint</jointName>
        <servo_min>@servo_min</servo_min>
        <servo_max>@servo_max</servo_max>
        <type>COMMAND</type>
        <cmd_topic>@thruster2_topic</cmd_topic>
        <offset>@control_offset</offset>
        <multiplier>@ccw_control_multiplier</multiplier>
      </control>
      <control channel="2">
        <jointName>thruster3_joint</jointName>
        <servo_min>@servo_min</servo_min>
        <servo_max>@servo_max</servo_max>
        <type>COMMAND</type>
        <cmd_topic>@thruster3_topic</cmd_topic>
        <offset>@control_offset</offset>
        <multiplier>@cw_control_multiplier</multiplier>
      </control>
      <control channel="3">
        <jointName>thruster4_joint</jointName>
        <servo_min>@servo_min</servo_min>
        <servo_max>@servo_max</servo_max>
        <type>COMMAND</type>
        <cmd_topic>@thruster4_topic</cmd_topic>
        <offset>@control_offset</offset>
        <multiplier>@cw_control_multiplier</multiplier>
      </control>
      <control channel="4">
        <jointName>thruster5_joint</jointName>
        <servo_min>@servo_min</servo_min>
        <servo_max>@servo_max</servo_max>
        <type>COMMAND</type>
        <cmd_topic>@thruster5_topic</cmd_topic>
        <offset>@control_offset</offset>
        <multiplier>@ccw_control_multiplier</multiplier>
      </control>
      <control channel="5">
        <jointName>thruster6_joint</jointName>
        <servo_min>@servo_min</servo_min>
        <servo_max>@servo_max</servo_max>
        <type>COMMAND</type>
        <cmd_topic>@thruster6_topic</cmd_topic>
        <offset>@control_offset</offset>
        <multiplier>@cw_control_multiplier</multiplier>
      </control>
      <control channel="6">
        <jointName>thruster7_joint</jointName>
        <servo_min>@servo_min</servo_min>
        <servo_max>@servo_max</servo_max>
        <type>COMMAND</type>
        <cmd_topic>@thruster7_topic</cmd_topic>
        <offset>@control_offset</offset>
        <multiplier>@cw_control_multiplier</multiplier>
      </control>
      <control channel="7">
        <jointName>thruster8_joint</jointName>
        <servo_min>@servo_min</servo_min>
        <servo_max>@servo_max</servo_max>
        <type>COMMAND</type>
        <cmd_topic>@thruster8_topic</cmd_topic>
        <offset>@control_offset</offset>
        <multiplier>@ccw_control_multiplier</multiplier>
      </control>
    </plugin>

  </model>
</sdf>
