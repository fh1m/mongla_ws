         Debug only; the autonomy stack must never consume this. -->
    <plugin
        filename="gz-sim-odometry-publisher-system"
        name="gz::sim::systems::OdometryPublisher">
      <odom_frame>dubomini/odom</odom_frame>
      <robot_base_frame>dubomini/base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>50.0</odom_publish_frequency>
    </plugin>

