<?xml version='1.0' encoding='UTF-8'?>
<!--
  TEMPLATE - do not edit the generated model.sdf, edit this file and configs.yaml
  then run:
    scripts/generate_model.py \
      models/dubomini/model.sdf.in \
      models/dubomini/model.sdf \
      models/dubomini/configs.yaml

  Duburi 4.5 simulator proxy. Physically this is the BlueROV2 Heavy hull, chosen
  because it shares the vectored_6dof eight-thruster frame with Duburi 4.5, which
  is what ArduSub actually mixes against. The octagonal aluminium hull is a V0.2
  concern.

  Derived from bluerov2_gz by Clyde McQueen (MIT). See ATTRIBUTION.md.
-->
<!-- 1.11, not the 1.6 bluerov2_gz uses: //inertial/fluid_added_mass arrived in
     1.10 and is silently dropped by the converter from anything older. -->
<sdf version="1.11">
  <model name="dubomini">
    <pose>0 0 0 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <pose>0.0 0.0 0.0 0 0 0</pose>
        <mass>14.6</mass>
        <inertia>
          <ixx>0.28</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.35</iyy>
          <iyz>0</iyz>
          <izz>0.52</izz>
        </inertia>

        <!-- Added mass, folded into the spatial inertia by dartsim. This does
             NOT belong in the Hydrodynamics plugin below: that applies added
             mass explicitly and diverges once a term exceeds the rigid-body
             mass, which heave does here by 40%. Positive by definition; the
             plugin's equivalent tags are negative. Off-diagonal terms are zero
             because the identified model is diagonal. -->
        <fluid_added_mass>
          <xx>8.5697</xx>
          <yy>10.8124</yy>
          <zz>64.5087</zz>
          <pp>0.2937</pp>
          <qq>0.6185</qq>
          <rr>0.0718</rr>
        </fluid_added_mass>
      </inertial>

      <!-- THE REAL VEHICLE. `hullv3.stl` decimated to ~200k faces by
           scripts/gen_vehicle_mesh.py, which also bakes the CAD's Y-up frame
           into Gazebo's Z-up (roll +90) and mm into m. The rotation is baked
           rather than applied as a <pose> because a pose would rotate the
           visual and NOT the collision or the thruster coordinates derived
           from the same file -- and a mismatch between those three is
           invisible until the vehicle flies sideways.

           No <material>: the mesh carries its own, and one SDF material
           flattens every one of them. That mistake cost a round on the other
           vehicle. -->
      <!-- ONE VISUAL PER PART CLASS. The previous export merged all 3,276
           CAD components into a single geometry with a single material, so the
           vehicle could only ever be one flat colour -- and it had NO VERTEX
           NORMALS, so the renderer had no shading information either. It read
           as a pale blob for both reasons at once.

           Colours are SAMPLED from the team's own render (see configs.yaml),
           not chosen. This vehicle is near-black. -->

      <visual name="frame_visual">
        <!-- the four long rails and plates -- the vehicle silhouette -->
        <geometry>
          <mesh>
            <uri>model://dubomini/meshes/dubomini_frame.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.375 0.375 0.38 1</ambient>
          <diffuse>0.375 0.375 0.38 1</diffuse>
          <specular>0.22 0.22 0.22 1</specular>
          <emissive>0.0375 0.0375 0.038 1</emissive>
        </material>
      </visual>

      <visual name="enclosure_visual">
        <!-- the sealed electronics box: GLOSS black, high specular -->
        <geometry>
          <mesh>
            <uri>model://dubomini/meshes/dubomini_enclosure.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.034 1</ambient>
          <diffuse>0.03 0.03 0.034 1</diffuse>
          <specular>0.65 0.65 0.65 1</specular>
          <emissive>0.003 0.003 0.0034 1</emissive>
        </material>
      </visual>

      <visual name="body_visual">
        <!-- pressure cylinders and mounts -->
        <geometry>
          <mesh>
            <uri>model://dubomini/meshes/dubomini_body.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.11 1</ambient>
          <diffuse>0.1 0.1 0.11 1</diffuse>
          <specular>0.35 0.35 0.35 1</specular>
          <emissive>0.01 0.01 0.011 1</emissive>
        </material>
      </visual>

      <visual name="duct_visual">
        <!-- the eight T200 ducts, with the blue-teal props inside them -->
        <geometry>
          <mesh>
            <uri>model://dubomini/meshes/dubomini_duct.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.115 0.115 0.12 1</ambient>
          <diffuse>0.115 0.115 0.12 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
          <emissive>0.0115 0.0115 0.012 1</emissive>
        </material>
      </visual>

      <visual name="prop_visual">
        <!-- the eight propellers, the one coloured thing on a black vehicle -->
        <geometry>
          <mesh>
            <uri>model://dubomini/meshes/dubomini_prop.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.105 0.135 0.175 1</ambient>
          <diffuse>0.105 0.135 0.175 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
          <emissive>0.0105 0.0135 0.0175 1</emissive>
        </material>
      </visual>

      <visual name="fitting_visual">
        <!-- brackets, clamps and the bare-metal camera bezels -->
        <geometry>
          <mesh>
            <uri>model://dubomini/meshes/dubomini_fitting.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.31 1</ambient>
          <diffuse>0.3 0.3 0.31 1</diffuse>
          <specular>0.45 0.45 0.45 1</specular>
          <emissive>0.03 0.03 0.031 1</emissive>
        </material>
      </visual>

      <!-- This box is NOT the hull. Its volume times fluid_density equals the
           displaced mass, which is what gz-sim-buoyancy-system integrates. The
           generator derives collision_z from mass, bounding box and density, so
           never hand-edit it. The offset between the inertial pose (centre of
           mass) and this pose (centre of volume) is the entire source of the
           vehicle's righting moment in roll and pitch. -->
      <collision name="base_link_collision">
        <pose>0.0 0.0 0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>0.5459 0.4702 0.057659</size>
          </box>
        </geometry>
      </collision>

      <!-- THE SHAPE THE VEHICLE HITS THINGS WITH, separate from the buoyancy
           box above. Gazebo Harmonic decomposes this itself:
           `optimization="convex_decomposition"` is the documented path for a
           complex non-water-tight mesh and needs no V-HACD install, no baked
           hull files and no second copy of the geometry to drift.

           It reads the CONVEX HULL export rather than the 2.15 M-face
           assembly -- 2,472 faces against 203,404 -- because a collision mesh
           is felt, not seen, and decomposing the full assembly would cost far
           more than the fidelity is worth. An open frame's true shape is not
           its hull, so this OVER-estimates contact: the vehicle will clip a
           slalom pipe slightly before its ducts really would. That is the safe
           direction and it is stated rather than discovered. -->
      <collision name="base_link_hull_collision">
        <geometry>
          <mesh optimization="convex_decomposition">
            <convex_decomposition>
              <max_convex_hulls>16</max_convex_hulls>
            </convex_decomposition>
            <uri>model://dubomini/meshes/dubomini_hull.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <!-- IMU gyro and accel are consumed by ArduSub over the JSON link. The
           1000 Hz rate must be at least the SITL loop rate. -->
      <sensor name="imu_sensor" type="imu">
        <!-- Gazebo body frame (x-forward, y-left, z-up)
             to ArduPilot body frame (x-forward, y-right, z-down) -->
        <pose>0 0 0 3.141593 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000.0</update_rate>
      </sensor>

      <!-- Doppler Velocity Log, downward-looking 4-beam janus array. Stands in
           for the Nortek Nucleus1000 on the real hull, so `yaw_source=sim_dvl`
           gives duburi_ws real bottom-track position feedback and the DVL
           distance verbs close their loop in sim instead of dead-reckoning.

           ON base_link ON PURPOSE, not on a child link of its own.
           gz-sim only populates a link's velocity components when something
           enables them, and the OdometryPublisher below does that for the
           canonical link only. Mounted on its own child link the sensor still
           reported bottom lock and a plausible range but a velocity of ~0.009
           m/s while Gazebo's own odometry read 0.698 m/s: measured, not
           guessed. The reference world at
           /usr/share/gz/gz-sim8/worlds/dvl_world.sdf says the same thing with
           its element_id="base_link": that attribute is placement, not just
           include-override syntax. Move this to a child link and it silently
           reads zero again.

           Needs gz::sim::systems::DopplerVelocityLogSystem in the world, which
           duburi_sim_worlds/templates/world.sdf.template loads. Without it the
           sensor loads and never publishes, the same silent trap as the
           cameras and gz-sim-sensors-system. -->
      <sensor name="dvl" type="custom" gz:type="dvl">
        <!-- Offset to the hull underside; 180 deg roll points the array down. -->
        <pose degrees="true">0.0 0.0 -0.1 0 0 180</pose>
        <always_on>1</always_on>
        <update_rate>8.0</update_rate>
        <!-- RAW, because `fault_injection` republishes this as
             `dvl/velocity` -- the topic the autonomy stack actually reads.
             That interposition is the only way to simulate a DVL dropout: the
             stack subscribes to Gazebo directly (SimDvlSource), so nothing on
             the ROS side can take the sensor away from it. Same shape as the
             T200 curve sitting on cmd_thrust_linear.
             CONSEQUENCE: without that node running there is no `dvl/velocity`
             at all, and every *_dist verb refuses. -->
        <topic>dvl/velocity_raw</topic>
        <gz:dvl>
          <type>phased_array</type>
          <arrangement degrees="true">
            <beam id="1">
              <aperture>2</aperture><rotation>45</rotation><tilt>30</tilt>
            </beam>
            <beam>
              <aperture>2</aperture><rotation>135</rotation><tilt>30</tilt>
            </beam>
            <beam>
              <aperture>2</aperture><rotation>-45</rotation><tilt>30</tilt>
            </beam>
            <beam>
              <aperture>2</aperture><rotation>-135</rotation><tilt>30</tilt>
            </beam>
          </arrangement>
          <tracking>
            <bottom_mode>
              <when>best</when>
              <noise type="gaussian">
                <stddev>0.0065</stddev>
              </noise>
              <!-- Draws the four beams in the GAZEBO GUI. NOT cheap, despite
                   what this comment used to claim: these are debug visuals on
                   the shared Ogre2 render thread, and enabling them takes the
                   cameras from 12.75 Hz to 2.83 Hz and multiplies frame jitter
                   by 76x (see DVL_DEFAULTS in generate_model.py for the
                   measurement). dvl_bridge.py publishes the same beams as an
                   RViz MarkerArray, which costs nothing. Default off. -->
              <visualize>false</visualize>
            </bottom_mode>
          </tracking>
          <resolution>0.01</resolution>
          <!-- The SAUVC pool is 1.6 m deep, so the useful altitude band is well
               under a metre: minimum_range matters far more than maximum. -->
          <maximum_range>75.0</maximum_range>
          <minimum_range>0.1</minimum_range>
          <!-- ENU to SFM -->
          <reference_frame>0 0 0 0 0 -1.570796</reference_frame>
        </gz:dvl>
      </sensor>
    </link>

    <!-- ======================= CAMERAS =======================
         Bridged to /duburi/sim/{front,bottom}_camera/image_raw, which is what
         the sim_front and sim_bottom profiles in duburi_vision/config/cameras.yaml
         subscribe to. The 640x480 resolution is fixed by those profiles.

         These need gz-sim-sensors-system with the ogre2 render engine loaded in
         the world, otherwise they silently never publish.
    -->
    <link name="front_camera_link">
      <pose>0.2 0.0 0.0 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz>
        </inertia>
      </inertial>
      <!-- No collision geometry on purpose: a collision here would add displaced
           volume and break the buoyancy budget computed above. -->
      <sensor name="front_camera" type="camera">
        <always_on>1</always_on>
        <update_rate>30.0</update_rate>
        <visualize>false</visualize>
        <topic>front_camera</topic>
        <camera name="front_camera">
          <!-- Without this both cameras default to a bare /camera_info and
               stomp on each other. -->
          <camera_info_topic>front_camera/camera_info</camera_info_topic>
          <horizontal_fov>1.0064</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <!-- Stands in for water turbidity; beyond this the pool fades out. -->
            <far>30.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
          <optical_frame_id>front_camera_link_optical</optical_frame_id>
        </camera>
      
        <!-- SUN GLARE. RoboSub and SAUVC are both run in OUTDOOR pools under
             direct sun, so glare is not decoration -- it is the dominant
             appearance of a frame looking anywhere near the surface, and a
             detector that has never seen it meets it for the first time at the
             competition.

             `LensFlare` is a first-party Harmonic RENDER PASS and it attaches
             INSIDE the <sensor>, which is the server-side sensor path -- so
             unlike <scene><fog> and the particle emitter, it reaches camera
             images rather than only the GUI. That distinction is the whole
             reason this is achievable at all; see TROUBLESHOOTING.md.

             STRIPPED, not disabled, when off. `always_on 0` does not stop a
             Gazebo sensor rendering and a disabled plugin still costs its pass
             -- the same trap that made the range cameras cost a third of the
             frame rate while claiming to be off. -->
        <plugin filename="gz-sim-lens-flare-system"
                name="gz::sim::systems::LensFlare">
          <!-- MEASURED AND UNPROVEN -- read before spending time here.
               The plugin DOES load and bind: at `-v 4` gz prints "Lens flare
               attached to camera named" for both cameras. It then produces NO
               MEASURABLE OUTPUT in this scene. Tested pointing up at the sun
               from underwater and from the air, with `light_name` bound to the
               directional `sun` AND to a purpose-added positional light:

                   flare off   mean 99.8  p99 118  saturated 0.00 %
                   flare on    mean 99.5  p99 117  saturated 0.00 %
                   point light mean 99.3  p99 117  saturated 0.00 %

               So the wiring is kept and correct, and the EFFECT is delivered by
               `underwater_fx.SurfaceGlare` instead -- the same decision the
               fog and the particle emitter forced. Do not re-run this
               experiment; it is recorded so nobody has to. -->
          <light_name>sun</light_name>
          <scale>0.4</scale>
          <color>1 0.95 0.85</color>
        </plugin>
        <!-- LENSFLARE -->
      </sensor>

      <!-- Ground-truth 2D boxes, from the GPU, for dataset labelling.
           Occlusion- and truncation-correct ONLY SINCE 2026-08-31: the
           box_type below asked for `2d`, which is not a valid token, so gz
           used FULLBOX2D and handed a full box to a crate hidden behind
           another one -- exactly what this comment used to claim had been
           fixed.

           A box is emitted ONLY for a model carrying a <label>, set by the
           gz-sim-label-system plugin that prop_library.model() writes. An
           unlabelled prop is silently absent from every annotation.

           Same intrinsics as the colour camera above -- the boxes have to be
           in the same image frame as the pixels they annotate, so the two
           sensors share every camera token rather than getting their own. -->
      <!-- RANGE image, for PER-PIXEL attenuation.
           underwater_fx attenuates by the VEHICLE's depth, so every pixel is
           degraded identically and a wall 20 m away is exactly as clear as the
           floor 1 m below. Real water attenuates along the PATH THE LIGHT
           TRAVELLED, which is what makes a distant prop fade while a near one
           stays sharp -- the single strongest depth cue an underwater image
           has, and the thing a detector must cope with at range.

           A depth_camera rather than an rgbd_camera: rgbd would move the
           colour topic and break the image_raw contract every consumer relies
           on. This is additive. -->
      <sensor name="front_range" type="depth_camera">
        <!-- always_on=0 does NOT stop this rendering: Gazebo creates the
             sensor regardless and the render pass is paid anyway. Measured:
             the topics were still published and the cameras still ran slow
             with always_on=0. The generator therefore OMITS this whole block
             unless configs.yaml sets range_cameras: true. -->
        <always_on>1</always_on>
        <update_rate>10.0</update_rate>
        <visualize>false</visualize>
        <topic>front_range</topic>
        <camera name="front_range">
          <horizontal_fov>1.0064</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>30.0</far>
          </clip>
          <optical_frame_id>front_camera_link_optical</optical_frame_id>
        </camera>
      </sensor>

      <sensor name="front_boxes" type="boundingbox_camera">
        <always_on>1</always_on>
        <update_rate>30.0</update_rate>
        <visualize>false</visualize>
        <topic>front_boxes</topic>
        <camera name="front_boxes">
          <!-- `visible_2d`, NOT `2d`. `2d` IS NOT A VALID TOKEN -- the set is
               full_2d / full_box_2d / visible_2d / visible_box_2d / 3d -- so
               gz silently fell back to its default, BBT_FULLBOX2D, documented
               as "the full box of OCCLUDED objects". Every dataset captured
               before 2026-08-31 therefore has no occlusion correctness at all,
               while the comment below claimed the opposite. An invalid token
               costs one line in stderr and nothing else, which is why it stood
               for so long. -->
          <box_type>visible_2d</box_type>
          <horizontal_fov>1.0064</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>30.0</far>
          </clip>
          <optical_frame_id>front_camera_link_optical</optical_frame_id>
        </camera>
      </sensor>
    </link>

    <joint name="front_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_camera_link</child>
    </joint>

    <link name="bottom_camera_link">
      <!-- Pitched 90 degrees down. -->
      <pose>0.0 0.0 -0.1 0 1.570796 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz>
        </inertia>
      </inertial>
      <sensor name="bottom_camera" type="camera">
        <always_on>1</always_on>
        <update_rate>30.0</update_rate>
        <visualize>false</visualize>
        <topic>bottom_camera</topic>
        <camera name="bottom_camera">
          <camera_info_topic>bottom_camera/camera_info</camera_info_topic>
          <horizontal_fov>1.0064</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>30.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
          <optical_frame_id>bottom_camera_link_optical</optical_frame_id>
        </camera>
      
        <!-- SUN GLARE. RoboSub and SAUVC are both run in OUTDOOR pools under
             direct sun, so glare is not decoration -- it is the dominant
             appearance of a frame looking anywhere near the surface, and a
             detector that has never seen it meets it for the first time at the
             competition.

             `LensFlare` is a first-party Harmonic RENDER PASS and it attaches
             INSIDE the <sensor>, which is the server-side sensor path -- so
             unlike <scene><fog> and the particle emitter, it reaches camera
             images rather than only the GUI. That distinction is the whole
             reason this is achievable at all; see TROUBLESHOOTING.md.

             STRIPPED, not disabled, when off. `always_on 0` does not stop a
             Gazebo sensor rendering and a disabled plugin still costs its pass
             -- the same trap that made the range cameras cost a third of the
             frame rate while claiming to be off. -->
        <plugin filename="gz-sim-lens-flare-system"
                name="gz::sim::systems::LensFlare">
          <!-- MEASURED AND UNPROVEN -- read before spending time here.
               The plugin DOES load and bind: at `-v 4` gz prints "Lens flare
               attached to camera named" for both cameras. It then produces NO
               MEASURABLE OUTPUT in this scene. Tested pointing up at the sun
               from underwater and from the air, with `light_name` bound to the
               directional `sun` AND to a purpose-added positional light:

                   flare off   mean 99.8  p99 118  saturated 0.00 %
                   flare on    mean 99.5  p99 117  saturated 0.00 %
                   point light mean 99.3  p99 117  saturated 0.00 %

               So the wiring is kept and correct, and the EFFECT is delivered by
               `underwater_fx.SurfaceGlare` instead -- the same decision the
               fog and the particle emitter forced. Do not re-run this
               experiment; it is recorded so nobody has to. -->
          <light_name>sun</light_name>
          <scale>0.4</scale>
          <color>1 0.95 0.85</color>
        </plugin>
        <!-- LENSFLARE -->
      </sensor>

      <!-- Ground-truth 2D boxes, from the GPU, for dataset labelling.
           Occlusion- and truncation-correct ONLY SINCE 2026-08-31: the
           box_type below asked for `2d`, which is not a valid token, so gz
           used FULLBOX2D and handed a full box to a crate hidden behind
           another one -- exactly what this comment used to claim had been
           fixed.

           A box is emitted ONLY for a model carrying a <label>, set by the
           gz-sim-label-system plugin that prop_library.model() writes. An
           unlabelled prop is silently absent from every annotation.

           Same intrinsics as the colour camera above -- the boxes have to be
           in the same image frame as the pixels they annotate, so the two
           sensors share every camera token rather than getting their own. -->
      <!-- RANGE image, for PER-PIXEL attenuation.
           underwater_fx attenuates by the VEHICLE's depth, so every pixel is
           degraded identically and a wall 20 m away is exactly as clear as the
           floor 1 m below. Real water attenuates along the PATH THE LIGHT
           TRAVELLED, which is what makes a distant prop fade while a near one
           stays sharp -- the single strongest depth cue an underwater image
           has, and the thing a detector must cope with at range.

           A depth_camera rather than an rgbd_camera: rgbd would move the
           colour topic and break the image_raw contract every consumer relies
           on. This is additive. -->
      <sensor name="bottom_range" type="depth_camera">
        <!-- always_on=0 does NOT stop this rendering: Gazebo creates the
             sensor regardless and the render pass is paid anyway. Measured:
             the topics were still published and the cameras still ran slow
             with always_on=0. The generator therefore OMITS this whole block
             unless configs.yaml sets range_cameras: true. -->
        <always_on>1</always_on>
        <update_rate>10.0</update_rate>
        <visualize>false</visualize>
        <topic>bottom_range</topic>
        <camera name="bottom_range">
          <horizontal_fov>1.0064</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>30.0</far>
          </clip>
          <optical_frame_id>bottom_camera_link_optical</optical_frame_id>
        </camera>
      </sensor>

      <sensor name="bottom_boxes" type="boundingbox_camera">
        <always_on>1</always_on>
        <update_rate>30.0</update_rate>
        <visualize>false</visualize>
        <topic>bottom_boxes</topic>
        <camera name="bottom_boxes">
          <!-- `visible_2d`, NOT `2d`. `2d` IS NOT A VALID TOKEN -- the set is
               full_2d / full_box_2d / visible_2d / visible_box_2d / 3d -- so
               gz silently fell back to its default, BBT_FULLBOX2D, documented
               as "the full box of OCCLUDED objects". Every dataset captured
               before 2026-08-31 therefore has no occlusion correctness at all,
               while the comment below claimed the opposite. An invalid token
               costs one line in stderr and nothing else, which is why it stood
               for so long. -->
          <box_type>visible_2d</box_type>
          <horizontal_fov>1.0064</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>30.0</far>
          </clip>
          <optical_frame_id>bottom_camera_link_optical</optical_frame_id>
        </camera>
      </sensor>
    </link>

    <joint name="bottom_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>bottom_camera_link</child>
    </joint>

    <!-- Hydrodynamics: Fossen model, applied by stock gz-sim.
         Also subscribes to /model/dubomini/ocean_current for a
         gz.msgs.Vector3d, which is the hook for pool disturbance injection. -->
    <plugin
        filename="gz-sim-hydrodynamics-system"
        name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <water_density>1000.0</water_density>
      <!-- Added mass is deliberately left at the zero default here; it lives in
           base_link's <fluid_added_mass> instead. Setting it in both places
           double-counts, and setting it only here is unstable. -->
      <!-- First order stability derivative: -->
      <xU>-13.7</xU>
      <yV>0.0</yV>
      <zW>-33.0</zW>
      <kP>0.0</kP>
      <mQ>-0.8</mQ>
      <nR>0.0</nR>
      <!-- Second order stability derivative: -->
      <xUabsU>-141.0</xUabsU>
      <yVabsV>-217.0</yVabsV>
      <zWabsW>-190.0</zWabsW>
      <kPabsP>-1.192</kPabsP>
      <mQabsQ>-0.47</mQabsQ>
      <nRabsR>-1.5</nRabsR>
    </plugin>

