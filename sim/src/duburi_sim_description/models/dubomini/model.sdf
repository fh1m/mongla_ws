    <!-- ArduSub link. type=COMMAND means this plugin does not actuate the joint
         itself; it republishes a gz.msgs.Double onto cmd_topic, which the
         Thruster plugin above consumes. Chain is:
           ArduSub -> PWM over UDP 9002 -> here -> cmd_thrust_linear
                   -> duburi_sim_bridge/t200_curve -> cmd_thrust -> joint force.

         The topic is cmd_thrust_LINEAR because this plugin can only apply an
         affine map, `(normalised_pwm + offset) * multiplier`. A real T200 has a
         +/-28 us deadband, makes only ~78 % of its forward thrust in reverse,
         and follows a quadratic -- a straight line is out by 12 N, 24 % of full
         thrust, and worst exactly where fine corrections live. t200_curve
         reshapes it against Blue Robotics' published performance data.

         WITHOUT that node running the thrusters receive NOTHING: this topic
         has no other subscriber. duburi_sim's `sim` starts it; if you launch
         sim.launch.py by hand, pass t200:=true (the default). -->

    <plugin name="ArduPilotPlugin" filename="libArduPilotPlugin.so">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>

      <!-- Gazebo body frame (x-forward, y-left, z-up)
           to ArduPilot body frame (x-forward, y-right, z-down) -->
      <modelXYZToAirplaneXForwardZDown>0 0 0 3.141593 0 0</modelXYZToAirplaneXForwardZDown>

      <!-- Gazebo world frame (ENU) to ArduPilot world frame (NED) -->
      <gazeboXYZToNED>0 0 0 3.141593 0 1.570796</gazeboXYZToNED>

      <imuName>imu_sensor</imuName>

      <control channel="0">
        <jointName>thruster1_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/dubomini/joint/thruster1_joint/cmd_thrust_linear</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="1">
        <jointName>thruster2_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/dubomini/joint/thruster2_joint/cmd_thrust_linear</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="2">
        <jointName>thruster3_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/dubomini/joint/thruster3_joint/cmd_thrust_linear</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="3">
        <jointName>thruster4_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/dubomini/joint/thruster4_joint/cmd_thrust_linear</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="4">
        <jointName>thruster5_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/dubomini/joint/thruster5_joint/cmd_thrust_linear</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="5">
        <jointName>thruster6_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/dubomini/joint/thruster6_joint/cmd_thrust_linear</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="6">
        <jointName>thruster7_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/dubomini/joint/thruster7_joint/cmd_thrust_linear</cmd_topic>
        <offset>-0.5</offset>
