<?xml version="1.0"?>
<model>
  <name>dubomini</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Dubomini 2.0, BRACU Duburi's compact 8-thruster AUV. Geometry from the
    team's own CAD export (hullv3.stl); mass and dimensions from the published
    spec at bracuduburi.com/auv/dubomini. Buoyancy and hydrodynamic
    coefficients are ASSUMED and marked as such in configs.yaml.
  </description>
</model>
