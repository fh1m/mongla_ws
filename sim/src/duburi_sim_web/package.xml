<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>duburi_sim_web</name>
  <version>0.1.0</version>
  <description>Operator web lab for Duburi simulator dataset collection.</description>
  <maintainer email="fh1m@users.noreply.github.com">fh1m</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>ament_index_python</depend>
  <exec_depend>duburi_sim_bridge</exec_depend>
  <exec_depend>duburi_sim_bringup</exec_depend>
  <exec_depend>duburi_sim_scenarios</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
