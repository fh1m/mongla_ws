<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>duburi_sim_scenarios</name>
  <version>0.1.0</version>
  <description>
    Runtime control of simulator props: spawn, move and delete competition
    elements without restarting Gazebo.
  </description>

  <maintainer email="fh1m@users.noreply.github.com">fh1m</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>ros_gz_interfaces</depend>

  <exec_depend>duburi_sim_worlds</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
